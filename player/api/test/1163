sOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Предварительный диагноз поставлен неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 8, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:47.932461Z", "updated_at": "2026-06-17T16:19:03.764741Z"}, {"id": 13981, "question_type_id": 2, "is_active": true, "test_id": 1163, "seq_no": 10, "body": {"name": "(3-1) Обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Частая желудочковая экстрасистолия, вероятно, идиопатическая, возникшая на фоне беременности. - Верно</strong></span></p><p>Источник: Желудочковые аритмии-2020, раздел 3.2, стр. 31. Появление или учащение аритмий — частое явление при беременности из-за гемодинамических и гормональных изменений. При отсутствии структурной патологии сердца прогноз обычно благоприятный [2].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Перипартальная кардиомиопатия. - Неверно</strong></span></p><p>Источник: Желудочковые аритмии-2020, раздел 3.3, стр. 74. Это заболевание характеризуется развитием систолической дисфункции левого желудочка и сердечной недостаточности, чего нет в данном случае.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Тиреотоксикоз. - Неверно</strong></span></p><p>Источник: Желудочковые аритмии-2020, раздел 2.3, стр. 18. Хотя тиреотоксикоз может вызывать аритмии, он обычно сопровождается и другими симптомами (тахикардия, потеря веса, тремор), и диагноз ставится на основании анализа уровня гормонов щитовидной железы.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 38, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:47.93673Z", "updated_at": "2026-06-06T10:21:47.93673Z"}, {"id": 13982, "