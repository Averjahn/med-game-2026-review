lectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Предварительный диагноз поставлен неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 8, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:51.288262Z", "updated_at": "2026-06-17T16:18:56.179241Z"}, {"id": 14197, "question_type_id": 2, "is_active": true, "test_id": 1171, "seq_no": 10, "body": {"name": "(3-1) Обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. ОКСбпST - Верно</strong></span></p><p>Нарастающая стенокардия, не полностью купируемая нитратами, множественные ФР (АГ, СД, дислипидемия) характерны для ОКСбпST [1, раздел 1.1, стр. 15; раздел 1.6, стр. 23].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Стабильная стенокардия напряжения - Неверно</strong></span></p><p>Прогрессирующий характер симптомов указывает на дестабилизацию ИБС [1, раздел 1.5, стр. 23].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Остеохондроз - Неверно</strong></span></p><p>Наличие ФР, связь с одышкой и ишемические изменения на ЭКГ делают кардиальную причину основной [1, раздел 2.1, стр. 25–26].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Паническая атака - Неверно</strong></span></p><p>Объективные данные (ЭКГ, тропонины) исключают паническую атаку как основной диагноз [1, раздел 2.1, стр. 26].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 38, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:51.29164Z", "updated_at": "2026-06-06T10:21:51.29164Z"}, {"id": 14198, "question_type_id": 2, "is_active": true, "test_id": 1171, "seq_no": 12, "body": {"name": "(4) Выберите необходимые лабораторные исследования", "content": [{"id": 1, "componentData": {"title": "Выберите необходимые лабораторные исследования"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": true, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Исследования назначены верно!", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": 