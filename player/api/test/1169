e": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "Фон лаборатории (анализаторы, пробирки)", "imageURL": "https://dev2.med-game.ru/files/test-1035/Лаборатория (1).png"}, "stepBackgroundImageOpacity": 0}, "internal_id": 28, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:50.514596Z", "updated_at": "2026-06-17T16:18:57.929288Z"}, {"id": 14145, "question_type_id": 2, "is_active": true, "test_id": 1169, "seq_no": 13, "body": {"name": "(4-1) Лабораторные исследования - обоснование", "content": [{"id": 1, "componentData": {"title": "Лабораторные исследования - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. ОАК - Верно</strong></span></p><p>Для исключения анемии и сопутствующих состояний [2, раздел 2.3, с.20–23].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>2. Глюкоза натощак, HbA1c - Верно</strong></span></p><p>Скрининг и контроль СД [2, раздел 2.3, с.21–22].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>3. Липидный профиль - Верно</strong></span></p><p>Ключ для оценки риска и целей терапии [2, раздел 2.3, с.21–23].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>4. Креатинин, СКФ/КК - Верно</strong></span></p><p>Для подбора доз и оценки риска [2, раздел 2.3, с.21].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>5. АЛТ/АСТ - Верно</strong></span></p><p>Мониторинг безопасности статинотерапии [2, раздел 2.3, с.23].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>6. NT-proBNP - Верно</strong></span></p><p>Оценка СН и прогноза [2, раздел 2.3, с.22].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>7. Тропонин высокочувствительный - Неверно</strong></span></p><p>Назначается при подозрении на ОКС/нестабильность [2, раздел 2.3, с.22].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>8. ТТГ/Т4 свободный - Верно</strong></span></p><p>При признаках тиреоидной дисфункции [2, раздел 2.3, с.22].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>9. Онкомаркеры - Неверно</strong></span></p><p>Не показаны при стабильной ИБС [2, раздел 2.3, с.20–23].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "Фон лаборатории (анализаторы, пробирки)", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 39, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:50.519494Z", "updated_at": "2026-06-06T10:21:50.519494Z"}, {"id": 14146, "question_type_id": 2, "is_active": true, "test_id": 1169, "seq_no": 2, "body": {"name": "Коридор (вставлено)", "content": [{"id": 1, "componentData": {"doors": [{"action": {"name": "moveToStep", "internalId": 2, "checkQuestion": false}, "points": [{"x": 15.416666666666668, "y": 22.12962962962963}, {"x": 19.6875, "y": 25.64814814814815}, {"x": 20.104166666666668, "y": 99.9074074074074}, {"x": 15.885416666666666, "y": 100}], "blurLabel": false, "buttonName": "Кардиолог", "isComplete": false, "labelPoints": [{"x": 15.46875, "y": 7.8970672414858125}, {"x": 31.030070377479205, "y": 7.8970672414858125}, {"x": 31.030070377479205, "y": 19.417747573328995}, {"x": 15.46875, "y": 19.417747573328995}], "hideOnMobile": false, "mobilePoints": [{"x": 3.049495131626397, "y": 35.48484519675926}, {"x": 7.912717016124877, "y": 36.73484519675926}, {"x": 8.39375869352429, "y": 74.59020543981481}, {"x":