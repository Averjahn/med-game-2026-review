ion": {"name": "next", "internalId": 49, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 43, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:00.488554Z", "updated_at": "2026-06-17T16:18:32.753821Z"}, {"id": 14804, "question_type_id": 2, "is_active": true, "test_id": 1194, "seq_no": 26, "body": {"name": "(9-1) Диспансеризация - обоснование", "content": [{"id": 1, "componentData": {"title": "Диспансеризация - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Наблюдение кардиолога и эндокринолога. Контроль ЭКГ. Оценка рисков. Контроль функции почек. - Верно</strong></span></p><p>Комплексный подход обеспечивает контроль основного и сопутствующих заболеваний и безопасность проводимой терапии. Источник: раздел 5, стр. 81 и Приложение Г2, Таблица П12, стр. 175.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Отменить антикоагулянтную терапию после нормализации гормонов и исчезновения приступов. - Неверно</strong></span></p><p>Решение о продолжении антикоагулянтной терапии принимается на основании риска по шкале CHA2DS2-VASc, а не на основании отсутствия пароксизмов. Источник: раздел 3.3.14, стр. 78.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false, "closeSessionPick": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 44, "question_text": "", "created_by": "admin", "