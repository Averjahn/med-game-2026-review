ction": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "План наблюдения составлен неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 43, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:03.677357Z", "updated_at": "2026-06-17T16:18:12.988895Z"}, {"id": 15012, "question_type_id": 2, "is_active": true, "test_id": 1202, "seq_no": 26, "body": {"name": "(9-1) Диспансеризация - обоснование", "content": [{"id": 1, "componentData": {"title": "Диспансеризация - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Плановый визит через 1 месяц для контроля переносимости новой терапии (АД, ЧСС, креатинин, калий). Далее — визиты не реже 2 раз в год. Ежегодная вакцинация от гриппа. Обучение пациента самоконтролю (взвешивание, контроль АД, ЧСС). Плановая ЭхоКГ через 1 год. - Верно</strong></span></p><p>План включает контроль безопасности после изменения терапии, регулярное наблюдение, профилактические мероприятия и обучение пациента, что соответствует современным подходам к ведению пациентов с ХСН.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 5, стр. 84-86; раздел 7.1, стр. 91. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Наблюдение не требуется, так как состояние стабильное. Явка при ухудшении. - Неверно</strong></span></p><p>Пациенты с ХСН нуждаются в пожизненном диспансерном наблюдении для контроля состояния и своевременной коррекции терапии, даже при стабильном течении.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 5, стр. 84. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Ежемесячный контроль уровня тропонина и NT-proBNP. - Неверно</strong></span></p><p>Рутинное ежемесячное определение этих маркеров у стабильного амбулаторного пациента нецелесообразно и не рекомендовано. NT-proBNP может контролироваться реже, а тропонин — только при подозрении на ОКС.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 2.3, стр. 23; раздел 7.3.2, стр. 97. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Ежегодная коронарография для контроля состояния стента. - Неверно</strong></span></p><p>При отсутствии симптомов стенокардии или признаков ишемии миокарда рутинная инвазивная коронарография не показана.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 2.4.4, стр. 30. [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 49, "checkQuestion": false, "closeSessionPick": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgro