notRequired": false}, {"id": 4, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Гипертоническая болезнь II стадии. Риск 3 (высокий).", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Предварительный диагноз поставлен неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 38, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 8, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:03.688611Z", "updated_at": "2026-06-17T16:18:13.11473Z"}, {"id": 15014, "question_type_id": 2, "is_active": true, "test_id": 1202, "seq_no": 10, "body": {"name": "(3-1) Обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Гипертоническая болезнь I стадии. Артериальная гипертензия 1 степени. Риск 2 (умеренный) - Верно</strong></span></p><p>Комментарий: У пациентки АГ 1 степени, избыточная масса тела, отягощенная наследственность и прием КОК. Отсутствие данных за поражение органов-мишеней (ПОМ) и ассоциированных клинических состояний (АКС) позволяет установить I стадию ГБ. Совокупность факторов соответствует умеренному сердечно-сосудистому риску.</p><p>Источник: Артериальная гипертензия у взрослых, 2024. Раздел 1.5, стр. 18-19, Приложение А3, таблица П15, стр. 185.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Вторичная артериальная гипертензия (на фоне приема КОК) - Неверно</strong></span></p><p>Комментарий: Хотя прием КОК может быть причиной вторичной АГ, более 90% всех случаев АГ составляет гипертоническая болезнь. Поэтому ГБ является наиболее вероятным диагнозом, а вопрос о вторичном характере АГ решается в ходе дообследования.</p><p>Источник: Артериальная гипертензия у взрослых, 2024. Раздел 1.1, стр. 13; Раздел 2.1, таблица П5, стр. 170.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Высокое нормальное артериальное давление - Неверно</strong></span></p><p>Комментарий: Уровень АД 152/94 мм рт. ст. соответствует АГ 1 степени (САД 140-159 и/или ДАД 90-99 мм рт. ст.), а не высокому нормальному АД (САД 130-139 и/или ДАД 85-89 мм рт. ст.).</p><p>Источник: Артериальная гипертензия у взрослых, 2024. Приложение А3, таблица П2, стр. 168.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Гипертоническая болезнь II стадии. Риск 3 (высокий) - Неверно</strong></span></p><p>Комментарий: II стадия ГБ устанавливается при наличии ПОМ, данных за которые на текущий момент нет. Соответственно, риск не может быть оценен как высокий без подтверждения ПОМ или наличия множественных факторов риска.</p><p>Источник: Артериальная гипертензия у взрослых, 2024. Раздел 1.5, стр. 20, Приложение А3, таблица П15, стр. 185.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false, "closeSessionPick": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false, "closeSessionPick": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 38, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:03.694005Z", "updated_at": "2026-06-06T10:22:03.694005Z"}, {"id": 15015, "question_type_id": 2, "is_active": true, "test_id": 1202, "seq_no": 14, "body": {"name": "(4.5) Коридор к инструментальным исследованиям", "content": [{"id": 1, "componentData": {"doors": [{"action": {"name": "moveToStep", "internalId": 0, "ch