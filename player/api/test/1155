e_id": 2, "is_active": true, "test_id": 1155, "seq_no": 6, "body": {"name": "(2.2) Анамнез заболевания", "content": [{"id": 1, "componentData": {"title": "Анамнез заболевания"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p>Заболел остро ночью после обильного ужина (жареное мясо, алкоголь). В течение года — периодические боли в эпигастрии, списывал на «несварение». Не обследовался.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 5, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:44.798917Z", "updated_at": "2026-06-06T10:21:44.798917Z"}, {"id": 13765, "question_type_id": 2, "is_active": true, "test_id": 1155, "seq_no": 7, "body": {"name": "(2.3) Анамнез жизни", "content": [{"id": 1, "componentData": {"title": "Анамнез жизни"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><strong>Хронические:</strong> АГ 5 лет, гипотензивные нерегулярно. СД отрицает.</p><p><strong>Вредные привычки:</strong> Не курит. Алкоголь 2-3 р/нед.</p><p><strong>Наследственность:</strong> Отец — СД 2 типа. Мать — ожирение.</p><p><strong>Аллергии:</strong> Нет.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 6, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:44.803455Z", "updated_at": "2026-06-06T10:21:44.803455Z"}, {"id": 13766, "question_type_id": 2, "is_active": true, "test_id": 1155, "seq_no": 8, "body": {"name": "(2.4) Объективное обследование", "content": [{"id": 1, "componentData": {"title": "Объективные данные"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"imagesList": [{"label": "", "imageURL": ""}], "clickEnlarge": true, "imagesWidthPercent": 80, "imagesWidthPercentSmall": 100, "imagesWidthPercentMobile": 100}, "componentName": "ContentImages"}, {"id": 3, "componentData": {"text": "<ul><li><p><strong>Состояние:</strong> Средней тяжести. Положение вынужденное (сидя, наклон вперед).</p></li><li><p><strong>Кожа:</strong> Бледная, влажная. На спине и ягодицах — множественные эруптивные ксантомы.</p></li><li><p><strong>Дыхание:</strong> Везикулярное. ЧДД 22.</p></li><li><p><strong>Сердце:</strong> Тоны приглушены. АД 150/95. Пульс 105 уд/мин.</p></li><li><p><strong>Живот:</strong> Вздут, болезненный в эпигастрии и левом подреберье. Перитонеальных симптомов нет.</p></li></ul>"}, "componentName": "ContentText"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 12, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:44.808124Z", "updated_at": "2026-06-06T10:21:44.808124Z"}, {"id": 13767, "question_type_id": 2, "is_active": true, "test_id": 1155, "seq_no": 9, "body": {"name": "(3) Предварительный диагноз", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": false, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Предварительный диагноз постав