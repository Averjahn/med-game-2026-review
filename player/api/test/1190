ion": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "Фон лаборатории (анализаторы, пробирки)", "imageURL": "https://dev2.med-game.ru/files/test-1035/Лаборатория (1).png"}, "stepBackgroundImageOpacity": 0}, "internal_id": 28, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:58.852069Z", "updated_at": "2026-06-17T16:18:35.718894Z"}, {"id": 14685, "question_type_id": 2, "is_active": true, "test_id": 1190, "seq_no": 13, "body": {"name": "(4-1) Лабораторные исследования - обоснование", "content": [{"id": 1, "componentData": {"title": "Лабораторные исследования - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Развернутый клинический анализ крови. - Верно</strong></span></p><p>Необходимо для исключения анемии и тромбоцитопении перед назначением антикоагулянтов. Источник: КР Фибрилляция и трепетание предсердий, 2020, раздел 2.5.1, стр. 20.</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>2. Биохимический анализ крови (креатинин, АЛТ, АСТ, билирубин, калий). - Верно</strong></span></p><p>Оценка функции почек (расчет клиренса креатинина) и печени обязательна для выбора дозы антикоагулянта. Источник: КР Фибрилляция и трепетание предсердий, 2020, раздел 2.5.1, стр. 21.</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>3. Коагулограмма (МНО). - Верно</strong></span></p><p>Необходимо определить исходное значение МНО для исключения нарушений свертывания перед началом терапии. Источник: КР Фибрилляция и трепетание предсердий, 2020, раздел 2.5.1, стр. 21.</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>4. Уровень ТТГ и свободного Т4. - Верно</strong></span></p><p>Необходимо исключить нарушение функции щитовидной железы как возможную причину ФП. Источник: КР Фибрилляция и трепетание предсердий, 2020, раздел 1.2, стр. 14.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>5. Ревматоидный фактор. - Неверно</strong></span></p><p>Данное исследование не входит в стандартный перечень обследования при ФП без специфических показаний. Источник: КР Фибрилляция и трепетание предсердий, 2020, раздел 2.3, стр. 19.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 39, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:58.856882Z", "updated_at": "2026-06-06T10:21:58.856882Z"}, {"id": 14686, "question_type_id": 2, "is_active": true, "test_id": 1190, "seq_no": 15, "body": {"name": "(5) Выберите необходимые инструментальные исследования", "content": [{"id": 1, "componentData": {"title": "Выберите необходимые инструментальные исследования"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": true, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Исследования назначены верно!", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 2, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "ЭКГ в 12 отведениях.", "isRightAlt