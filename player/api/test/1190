tons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Предварительный диагноз поставлен неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 8, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:58.842255Z", "updated_at": "2026-06-17T16:18:35.591389Z"}, {"id": 14683, "question_type_id": 2, "is_active": true, "test_id": 1190, "seq_no": 10, "body": {"name": "(3-1) Обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Пароксизмальная фибрилляция предсердий. - Верно</strong></span></p><p>Диагноз основан на жалобах пациента на нерегулярное сердцебиение и характерном анамнезе (приступы купируются самостоятельно в течение 48 часов). Источник: КР Фибрилляция и трепетание предсердий, 2020, раздел 1.5, стр. 16.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Синусовая тахикардия. - Неверно</strong></span></p><p>При синусовой тахикардии ритм сердца регулярный, а у пациентки отмечается аритмия и дефицит пульса. Источник: КР Фибрилляция и трепетание предсердий, 2020, раздел 2, стр. 17.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Желудочковая экстрасистолия. - Неверно</strong></span></p><p>Хотя экстрасистолия может вызывать ощущение перебоев, для нее не характерны длительные приступы с высокой ЧСС и одышкой. Источник: КР Фибрилляция и трепетание предсердий, 2020, раздел 1.6, стр. 16.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Паническая атака. - Неверно</strong></span></p><p>Хотя паническая атака может сопровождаться тахикардией, наличие аритмии и дефицита пульса указывает на кардиальную причину. Источник: КР Фибрилляция и трепетание предсердий, 2020, раздел 2.1, стр. 18.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 38, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:58.847268Z", "updated_at": "2026-06-06T10:21:58.847268Z"}, {"id": 14684, "question_type_id": 2, "is_active": true, "test_id": 1190, "seq_no": 12, "body": {"name": "(4) Выберите необходимые лабораторные исследования", "content": [{"id": 1, "componentData": {"title": "Выберите необходимые лабораторные исследования"}, "componentName": "ContentTitle"}, 