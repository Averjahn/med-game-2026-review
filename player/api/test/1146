ame": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 8, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:40.93056Z", "updated_at": "2026-06-17T16:19:21.181584Z"}, {"id": 13525, "question_type_id": 2, "is_active": true, "test_id": 1146, "seq_no": 10, "body": {"name": "(3-1) Обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Резистентная артериальная гипертензия - Верно</strong></span></p><p>Комментарий: Диагноз правомочен, так как АД не контролируется на фоне приёма трёх препаратов, включая диуретик.</p><p>Источник: Артериальная гипертензия у взрослых, 2024. Раздел 3.6.11, стр. 67.</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>2. Вторичная АГ на фоне первичного гиперальдостеронизма - Верно</strong></span></p><p>Комментарий: Наличие резистентной АГ в сочетании с мышечной слабостью и полиурией делает этот диагноз наиболее вероятным.</p><p>Источник: Артериальная гипертензия у взрослых, 2024. Таблица П5, стр. 24.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Эссенциальная (первичная) гипертензия - Неверно</strong></span></p><p>Комментарий: Наличие специфических симптомов и резистентности к лечению требует исключения вторичных причин АГ.</p><p>Источник: Артериальная гипертензия у взрослых, 2024. Раздел 1.1, стр. 13.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Феохромоцитома - Неверно</strong></span></p><p>Комментарий: Для феохромоцитомы характерн