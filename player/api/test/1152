d_at": "2026-06-06T10:21:43.622362Z", "updated_at": "2026-06-06T10:21:43.622362Z"}, {"id": 13683, "question_type_id": 2, "is_active": true, "test_id": 1152, "seq_no": 6, "body": {"name": "(2.2) Анамнез заболевания", "content": [{"id": 1, "componentData": {"title": "Анамнез заболевания"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p>Болен около года. Последние 3 месяца приступы 2–3 р/нед. Головокружение и слабость внезапные, иногда до предобморока, особенно после прекращения сердцебиения. Препаратов не принимал, к врачам не обращался.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 5, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:43.626534Z", "updated_at": "2026-06-06T10:21:43.626534Z"}, {"id": 13684, "question_type_id": 2, "is_active": true, "test_id": 1152, "seq_no": 7, "body": {"name": "(2.3) Анамнез жизни", "content": [{"id": 1, "componentData": {"title": "Анамнез жизни"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><strong>Хронические:</strong> ГБ II стадии (15 лет), адаптирован к 130/80. ИБС, стабильная стенокардия II ФК.</p><p><strong>Операции:</strong> Аппендэктомия (1985).</p><p><strong>Вредные привычки:</strong> Курит 1 пачку/день 40 лет. Алкоголь умеренно.</p><p><strong>Аллергии:</strong> Нет.</p><p><strong>Наследственность:</strong> У отца ИМ в 65 лет.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImag