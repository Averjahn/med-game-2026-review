reated_at": "2026-06-06T10:21:43.25077Z", "updated_at": "2026-06-06T10:21:43.25077Z"}, {"id": 13656, "question_type_id": 2, "is_active": true, "test_id": 1151, "seq_no": 6, "body": {"name": "(2.2) Анамнез заболевания", "content": [{"id": 1, "componentData": {"title": "Анамнез заболевания"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p>Ухудшение с 20-й недели беременности. Симптомы нарастают. Головокружение 2–3 раза в неделю, до минуты. Потери сознания не было. Препаратов не принимала.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 5, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:43.254272Z", "updated_at": "2026-06-06T10:21:43.254272Z"}, {"id": 13657, "question_type_id": 2, "is_active": true, "test_id": 1151, "seq_no": 7, "body": {"name": "(2.3) Анамнез жизни", "content": [{"id": 1, "componentData": {"title": "Анамнез жизни"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><strong>Беременность:</strong> Первая, без особенностей.</p><p><strong>Хронические заболевания:</strong> Нет. К кардиологу ранее не обращалась.</p><p><strong>Наследственность:</strong> Не отягощена.</p><p><strong>Аллергии:</strong> Нет.</p><p><strong>Вредные привычки:</strong> Нет.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 6, "question_text": "", "created_b