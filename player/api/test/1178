pendentAspectMobile": false, "labelIndependentAspectDesktop": false}], "image": {"label": "", "imageURL": "./stub-image.png"}, "blinkColor": "rgba(255, 212, 0, 0.47)", "hoverColor": "rgba(64, 158, 255, 0.28)", "showLabels": true, "blinkCycles": 7, "blinkStepMs": 520, "mobileImage": {"label": "", "imageURL": "./stub-image.png"}, "blinkOnEnter": true, "doorClickSound": {"label": "", "audioURL": "./stub-audio.wav"}, "labelsFontSize": 12, "useMobileImage": true, "enableDoorHover": true, "labelsFontFamily": "Montserrat, sans-serif", "blinkExpandEnabled": false, "markCompletedDoors": false, "blinkExpandMobileXPx": 30, "blinkExpandMobileYPx": 25, "labelsFontSizeMobile": 8, "blinkExpandDesktopXPx": 50, "blinkExpandDesktopYPx": 25, "labelsFontSizeDesktop": 16, "labelsFrameFillMobile": "#d2b894", "labelsMinWidthEnabled": true, "labelsBorderWidthMinPx": 125, "labelsFrameFillDesktop": "#d2b894", "labelsMinWidthMobilePx": 125, "labelsFrameBorderMobile": "rgb(115, 74, 41)", "labelsMinWidthDesktopPx": 125, "labelsFrameBorderDesktop": "rgb(115, 74, 41)", "labelsBorderWidthMobilePx": 5, "labelsBorderWidthDesktopPx": 5}, "componentName": "ContentCorridor"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 45, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:54.128851Z", "updated_at": "2026-06-06T10:21:54.128851Z"}, {"id": 14380, "question_type_id": 2, "is_active": true, "test_id": 1178, "seq_no": 18, "body": {"name": "(5-1) Инструментальные исследования - обоснование", "content": [{"id": 1, "componentData": {"title": "Инструментальные исследования - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Регистрация ЭКГ в 12 отведениях — Верно</strong></span></p><p>ЭКГ является ключевым методом диагностики, позволяющим установить тип ОКС и принять решение о стратегии реперфузии. Должна быть выполнена в течение 10 минут после первого медицинского контакта.</p><p>Источник: КР «Острый инфаркт миокарда с подъемом сегмента ST», 2024, раздел 2.4, стр. 26 [1].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>2. Коронарография (КГ) — Верно</strong></span></p><p>КГ является обязательным этапом в рамках стратегии первичного ЧКВ, которое является предпочтительным методом реперфузии в данном случае.</p><p>Источник: КР «Острый инфаркт миокарда с подъемом сегмента ST», 2024, раздел 2.4, стр. 28 [1].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>3. Эхокардиография (ЭхоКГ) — Верно</strong></span></p><p>ЭхоКГ необходима для оценки глобальной и локальной сократимости миокарда, ФВ ЛЖ, а также для выявления механических осложнений. Однако ее выполнение не должно задерживать проведение КГ и ЧКВ.</p><p>Источник: КР «Острый инфаркт миокарда с подъемом сегмента ST», 2024, раздел 2.4, стр. 28 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Рентгенография органов грудной клетки — Неверно</strong></span></p><p>Это исследование выполняется для дифференциальной диагностики, но не является первоочередным для принятия решения о реперфузии. Его можно выполнить позже, если позволяет состояние пациента.</p><p>Источник: КР «Острый инфаркт миокарда с подъемом сегмента ST», 2024, раздел 3.4.1.1, стр. 79 [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 46, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:54.13672Z", "updated_at": "2026-06-06T10:21:54.13672Z"}, {"id": 14381, "question_type_id": 2, "is_acti