, 3.2, стр. 13, 54. </p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. ИБС. Острый коронарный синдром без подъема сегмента ST. - Неверно</strong></span></p><p>Несмотря на небольшое повышение тропонинов (что возможно из-за шоков ИКД и тахикардии), данные коронарографии исключают ОКС . Источник: Желудочковые аритмии-2020, раздел 3.1, стр. 27-28.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 41, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:46.5037Z", "updated_at": "2026-06-06T10:21:46.5037Z"}, {"id": 13886, "question_type_id": 2, "is_active": true, "test_id": 1159, "seq_no": 23, "body": {"name": "(8) Лечение", "content": [{"id": 1, "componentData": {"title": "Определите оптимальную тактику лечения:"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": true, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Лечение назначено верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 3, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Внутривенное введение амиодарона и глубокая седация.", "isRightAlt": false, "notRequired":