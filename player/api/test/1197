ка индукции фибрилляции желудочков. Источник: раздел 3.1.2.1.2, стр. 44 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Внутривенное введение Прокаинамида. - Неверно</strong></span></p><p>Хотя прокаинамид может использоваться при гемодинамически стабильной ФП на фоне WPW, в условиях нестабильности методом выбора является ЭКВ. Источник: раздел 3.1.2.2.3, стр. 48, Таблица П15, стр. 177 [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 42, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:01.580976Z", "updated_at": "2026-06-06T10:22:01.580976Z"}, {"id": 14880, "question_type_id": 2, "is_active": true, "test_id": 1197, "seq_no": 19, "body": {"name": "(8) Диспансеризация и дальнейшее ведение", "content": [{"id": 1, "componentData": {"title": "Диспансеризация и дальнейшее ведение"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": false, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Тактика выбрана верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 2, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Направле