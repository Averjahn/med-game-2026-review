 false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Фибрилляция и трепетание предсердий, персистирующая форма.", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Атипичное (левопредсердное) трепетание предсердий.", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Диагноз поставлен неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 29, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 32, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:58.482273Z", "updated_at": "2026-06-06T10:21:58.482273Z"}, {"id": 14663, "question_type_id": 2, "is_active": true, "test_id": 1189, "seq_no": 24, "body": {"name": "(7-1) Клинический диагноз - обоснование", "content": [{"id": 1, "componentData": {"title": "Клинический диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Типичное трепетание предсердий, истмус-зависимое, постоянная форма. - Верно</strong></span></p><p>Диагноз установлен на основании характерной ЭКГ-картины (отрицательные волны F в нижних отведениях), что указывает на типичный, кавотрикуспидальный истмус-зависимый вариант ТП. Анамнез (длительность > 7 дней) позволяет классифицировать форму как постоянную. Источник: Наджелудочковые тахикардии 2025, разделы 1.4, 1.5, 2.4, стр. 18, 29.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Фибрилляция и трепетание предсердий, персистирующая форма. - Неверно</strong></span></p><p>На данный момент у пациента задокументировано только трепетание предсердий. Диагноз ФП не подтвержден, хотя риск ее развития в будущем высок. Источник: Наджелудочковые тахикардии 2025, раздел 1.6.4, стр. 22.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Атипичное (левопредсердное) трепетание предсердий. - Неверно</strong></span></p><p>ЭКГ-картина с «пилообразными» волнами в нижних отведениях характерна для типичного, правопредсердного ТП. Для атипичных форм характерна иная морфология волн F. Источник: Наджелудочковые тахикардии 2025, раздел 2.4, стр. 29.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 41, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:58.485385Z", "updated_at": "2026-06-06T10:21:58.485385Z"}, {"id": 14664, "question_type_id": 2, "is_active": true, "test_id": 1189, "seq_no": 25, "body": {"name": "(8) Лечение", "content": [{"id": 1, "componentData": {"title": "Определите оптимальную тактику ведения:"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": false, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Лечение назначено верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 2, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Назначить пероральный антикоагулянт (ПОАК) и направить на катетерную аблацию кавотрикуспидального истмуса.", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Провести электрическую кардиоверсию в амбулаторных условиях для восстановления синусового ритма.", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Назначить дигоксин для контроля ЧСС и отпустить под наблюдение терапевта.", "isRightAlt": false, "notRequired": false}, {"id": 4, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Назначить амиодарон для медикаментозной кардиоверсии и длительной антиаритмической терапии.", "isRightAlt": false, "notRequired": false}, {"id": 5, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Назначить бета-адреноблокатор для урежения ЧСС и рекомендовать повторный визит через 3 месяца.", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Лечение назначено неверно, скорректируйте", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 49, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 10, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:58.489999Z", "updated_at": "2026-06-17T16:18:37.242641Z"}, {"id": 14665, "question_type_id": 2, "is_active": true, "test_id": 1189, "seq_no": 26, "body": {"name": "(8-1) Лечение - обоснование", "content": [{"id": 1, "componentData": {"title": "Лечение - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Назначить пероральный антикоагулянт (ПОАК) и направить на катетерную аблацию кавотрикуспидального истмуса. - Верно</strong></span></p><p>Риск тромбоэмболий по шкале CHA₂DS₂-VASc = 3 балла (АГ+Возраст 65-74+СД), что требует назначения антикоагулянтов. Катетерная аблация является методом выбора при симптомном ТП. Источник: Наджелудочковые тахикардии 2025, разделы 3.2.4, стр. 43, 45.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Провести электрическую кардиоверсию в амбулаторных условиях. - Неверно</strong></span></p><p>Проведение кардиоверсии без предварительной антикоагулянтной подготовки (не менее 3 недель) или без исключения тромба при длительности аритмии > 48 часов опасно из-за высокого риска инсульта. Источник: Наджелудочковые тахикардии 2025, раздел 3.2.4, стр. 43.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Назначить дигоксин для контроля ЧСС. - Неверно</strong></span></p><p>Дигоксин малоэффективен для контроля ЧСС при ТП. Стратегия только контроля ЧСС уступает по эффективности катетерной аблации. Источник: Наджелудочковые тахикардии 2025, раздел 3.2.4, стр. 46.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Назначить амиодарон для медикаментозной кардиоверсии. - Неверно</strong></span></p><p>Амиодарон менее эффективен, чем аблация, и имеет множество побочных эффектов при длительном приеме. Источник: Наджелудочковые тахикардии 2025, раздел 3.2.4, стр. 45.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>5. Назначить бета-адреноблокатор для урежения ЧСС. - Неверно</strong></span></p><p>Стратегия контроля ЧСС является менее предпочтительной, чем катетерная аблация. Откладывание радикального лечения на 3 месяца при наличии симптомной аритмии неоправданно. Источник: Наджелудочковые тахикардии 2025, раздел 3.2.4, стр. 45.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 42, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:58.495276Z", "updated_at": "2026-06-06T10:21:58.495276Z"}, {"id": 14666, "question_type_id": 2, "is_active": true, "test_id": 1189, "seq_no": 27, "body": {"name": "(9) Диспансеризация", "content": [{"id": 1, "componentData": {"title": "Диспансеризация"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": true, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "План диспансеризации составлен верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 2, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Наблюдение у кардиолога/терапевта не реже 2 раз в год, ЭКГ 2 раза в год, Холтер-ЭКГ 1 раз в год для исключения рецидива ТП и выявления ФП.", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Продолжить прием пероральных антикоагулянтов пожизненно, учитывая высокий риск по шкале CHA₂DS₂-VASc.", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Ограничение физических нагрузок на 1 неделю после вмешательства.", "isRightAlt": false, "notRequired": false}, {"id": 4, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Отмена всех препаратов и снятие с диспансерного учета через 1 месяц после аблации.", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1, 2, 3], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "checkboxes", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "План диспансеризации составлен неверно, скорректируйте", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 49, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 43, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:58.4998Z", "updated_at": "2026-06-17T16:18:37.362165Z"}, {"id": 14667, "question_type_id": 2, "is_active": true, "test_id": 1189, "seq_no": 28, "body": {"name": "(9-1) Диспансеризация - обоснование", "content": [{"id": 1, "componentData": {"title": "Диспансеризация - обоснование", "titleIcon": {"label": "", "imageURL": ""}}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Наблюдение у кардиолога/терапевта не реже 2 раз в год. - Верно</strong></span></p><p>Регулярное наблюдение необходимо для контроля состояния, факторов риска и своевременного выявления ФП, которая часто развивается у пациентов с ТП в анамнезе. Источник: Наджелудочковые тахикардии 2025, раздел 5.4, стр. 67-68.</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>2. Продолжить прием пероральных антикоагулянтов пожизненно. - Верно</strong></span></p><p>Рекомендации по антикоагуляции при ТП аналогичны таковым при ФП. Учитывая, что риск по CHA₂DS₂-VASc (3 балла) не изменился, и высока вероятность развития ФП в будущем, антикоагулянтная терапия должна быть продолжена. Источник: Наджелудочковые тахикардии 2025, раздел 3.2.4, стр. 43.</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>3. Ограничение физических нагрузок на 1 неделю после вмешательства. - Верно</strong></span></p><p>Это стандартная рекомендация после катетерной аблации. Источник: Наджелудочковые тахикардии 2025, раздел 4, стр. 61.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Отмена всех препаратов и снятие с диспансерного учета через 1 месяц после аблации. - Неверно</strong></span></p><p>Это опасная тактика. Отмена антикоагулянтов при высоком риске по CHA₂DS₂-VASc недопустима. Пациент требует длительного наблюдения из-за риска ФП и необходимости контроля сопутствующих заболеваний. Источник: Наджелудочковые тахикардии 2025, разделы 3.2.4 и 5.4, стр. 43, 67.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 49, "checkQuestion": false, "closeSessionPick": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 44, "question_text": "", "created_by