, "columns": 2, "markers": [], "hintText": "", "multiple": false, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Клинический диагноз поставлен верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 3, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Основной: Гипертоническая болезнь III стадии, риск 4. Осложнения: Впервые выявленный пароксизм фибрилляции предсердий, тахисистолическая форма. Хроническая сердечная недостаточность с сохраненной фракцией выброса (ХСНсФВ), стадия 1, ФК IV. Острая декомпенсация сердечной недостаточности.", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Изолированная фибрилляция предсердий.", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Хроническая сердечная недостаточность со сниженной фракцией выброса (ХСНнФВ).", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Клинический диагноз поставлен неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 32, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:01.969316Z", "updated_at": "2026-06-17T16:18:28.857181Z"}, {"id": 14902, "question_type_id": 2, "is_active": true, "test_id": 1198, "seq_no": 22, "body": {"name": "(7-1) Клинический диагноз - обоснование", "content": [{"id": 1, "componentData": {"title": "Клинический диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Основной: Гипертоническая болезнь III стадии, риск 4. Осложнения: Впервые выявленный пароксизм фибрилляции предсердий, тахисистолическая форма. Хроническая сердечная недостаточность с сохраненной фракцией выброса (ХСНсФВ), стадия 1, ФК IV. Острая декомпенсация сердечной недостаточности. - Верно</strong></span></p><p>Диагноз полностью отражает этиологию (гипертоническая болезнь), острое аритмическое событие и его следствие — декомпенсацию ХСН. Указан тип ХСН (с сохраненной ФВ), стадия и ФК, соответствующий тяжести состояния.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 1.4, стр. 16-19. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Изолированная фибрилляция предсердий. - Неверно</strong></span></p><p>У пациентки имеются явные признаки тяжелой сердечной недостаточности, которая является основным жизнеугрожающим состоянием. ФП в данном случае — это триггер и проявление основного заболевания, а не изолированная аритмия.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 3.1.6.1, стр. 49. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Хроническая сердечная недостаточность со сниженной фракцией выброса (ХСНнФВ). - Неверно</strong></span></p><p>По данным ЭхоКГ фракция выброса составляет 52%, что соответствует ХСН с сохраненной ФВ (≥50%), а не со сниженной (≤40%). Это принципиально важно для выбора терапии.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 1.4, стр. 16. [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 41, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:01.975738Z", "updated_at": "2026-06-06T10:22:01.975738Z"}, {"id": 14903, "question_type_id": 2, "is_active": true, "test_id": 1198, "seq_no": 23, "body": {"name": "(8) Лечение", "content": [{"id": 1, "componentData": {"title": "Лечение"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": false, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Тактика лечения выбрана верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 3, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Тактика контроля частоты сердечных сокращений (ЧСС). Внутривенное введение петлевых диуретиков (фуросемид) для устранения застоя. Назначение бета-блокатора для урежения ЧСС. Назначение прямого орального антикоагулянта для профилактики инсульта.", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Немедленная электрическая кардиоверсия для восстановления синусового ритма.", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Назначение инфузии добутамина для улучшения сократимости и увеличение дозы лозартана.", "isRightAlt": false, "notRequired": false}, {"id": 4, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Назначить аспирин, внутримышечно фуросемид и выписать после улучшения.", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Тактика лечения выбрана неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 10, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:01.982542Z", "updated_at": "2026-06-17T16:18:28.97559Z"}, {"id": 14904, "question_type_id": 2, "is_active": true, "test_id": 1198, "seq_no": 24, "body": {"name": "(8-1) Лечение - обоснование", "content": [{"id": 1, "componentData": {"title": "Лечение - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Тактика контроля частоты сердечных сокращений (ЧСС). Внутривенное введение петлевых диуретиков (фуросемид) для устранения застоя. Назначение бета-блокатора для урежения ЧСС. Назначение прямого орального антикоагулянта для профилактики инсульта. - Верно</strong></span></p><p>У гемодинамически стабильной пациентки (АД 140/85) первоочередными задачами являются устранение застоя (диуретики) и урежение ЧСС (бета-блокаторы). Антикоагулянтная терапия обязательна из-за высокого риска тромбоэмболических осложнений при ФП.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 7.4, стр. 100; раздел 3.1.6.3, стр. 51; раздел 3.1.6.1, стр. 50. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Немедленная электрическая кардиоверсия для восстановления синусового ритма. - Неверно</strong></span></p><p>Экстренная кардиоверсия показана при гемодинамической нестабильности (шок, гипотония). У данной пациентки АД стабильное, поэтому следует выбрать стратегию контроля частоты. Кроме того, кардиоверсия без подготовки сопряжена с высоким риском инсульта.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 3.1.6.3, стр. 51. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Назначение инфузии добутамина для улучшения сократимости и увеличение дозы лозартана. - Неверно</strong></span></p><p>Инотропная поддержка (добутамин) не показана, так как у пациентки нет гипоперфузии («влажный и теплый» вариант ОДСН), а фракция выброса сохранена. Простое увеличение дозы лозартана не решит проблему тахикардии и застоя.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 7.4.1.5, стр. 111. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Назначить аспирин, внутримышечно фуросемид и выписать после улучшения. - Неверно</strong></span></p><p>Аспирин неэффективен для профилактики инсульта при ФП. Внутримышечное введение диуретиков менее эффективно, чем внутривенное при ОДСН. Выписка без назначения базисной терапии ХСН и антикоагулянтов является грубой ошибкой.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 3.1.3.1, стр. 45; раздел 7.4.1.4, стр. 107. [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 42, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:01.989365Z", "updated_at": "2026-06-06T10:22:01.989365Z"}, {"id": 14905, "question_type_id": 2, "is_active": true, "test_id": 1198, "seq_no": 25, "body": {"name": "(9) Диспансеризация", "content": [{"id": 1, "componentData": {"title": "Диспансеризация"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": false, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "План наблюдения составлен верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 3, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Плановый визит через 1 месяц для контроля переносимости новой терапии (АД, ЧСС, креатинин, калий). Далее — визиты не реже 2 раз в год. Ежегодная вакцинация от гриппа. Обучение пациента самоконтролю (взвешивание, контроль АД, ЧСС). Плановая ЭхоКГ через 1 год.", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Наблюдение не требуется, так как состояние стабильное. Явка при ухудшении.", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Ежемесячный контроль уровня тропонина и NT-proBNP.", "isRightAlt": false, "notRequired": false}, {"id": 4, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Ежегодная коронарография для контроля состояния стента.", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "План наблюдения составлен неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 43, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:01.999533Z", "updated_at": "2026-06-17T16:18:29.090704Z"}, {"id": 14906, "question_type_id": 2, "is_active": true, "test_id": 1198, "seq_no": 26, "body": {"name": "(9-1) Диспансеризация - обоснование", "content": [{"id": 1, "componentData": {"title": "Диспансеризация - обоснование", "titleIcon": {"label": "", "imageURL": ""}}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Плановый визит через 1 месяц для контроля переносимости новой терапии (АД, ЧСС, креатинин, калий). Далее — визиты не реже 2 раз в год. Ежегодная вакцинация от гриппа. Обучение пациента самоконтролю (взвешивание, контроль АД, ЧСС). Плановая ЭхоКГ через 1 год. - Верно</strong></span></p><p>План включает контроль безопасности после изменения терапии, регулярное наблюдение, профилактические мероприятия и обучение пациента, что соответствует современным подходам к ведению пациентов с ХСН.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 5, стр. 84-86; раздел 7.1, стр. 91. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Наблюдение не требуется, так как состояние стабильное. Явка при ухудшении. - Неверно</strong></span></p><p>Пациенты с ХСН нуждаются в пожизненном диспансерном наблюдении для контроля состояния и своевременной коррекции терапии, даже при стабильном течении.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 5, стр. 84. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Ежемесячный контроль уровня тропонина и NT-proBNP. - Неверно</strong></span></p><p>Рутинное ежемесячное определение этих маркеров у стабильного амбулаторного пациента нецелесообразно и не рекомендовано. NT-proBNP может контролироваться реже, а тропонин — только при подозрении на ОКС.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 2.3, стр. 23; раздел 7.3.2, стр. 97. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Ежегодная коронарография для контроля состояния стента. - Неверно</strong></span></p><p>При отсутствии симптомов стенокардии или признаков ишемии миокарда рутинная инвазивная коронарография не показана.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 2.4.4, стр. 30. [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 51, "checkQuestion": false, "closeSessionPick": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 44, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:02.006518Z", "updated_at": "2026-06-06T10:22:02.006518Z"}, {"id": 14907, "question_type_id": 2, "is_active": true, "test_id": 1198, "seq_no": 2, "body": {"name": "(0.5) Коридор", "content": [{"id": 1, "componentData": {"doors": [{"action": {"name": "moveToStep", "internalId": 2, "checkQuestion": false}, "points": [{"x": 14.562013278753994, "y": 23.094058852466347}, {"x": 18.9849366014377, "y": 26.761157819417736}, {"x": 19.024872703674124, "y": 94.59354456419659}, {"x": 14.522077176517573, "y": 100}], "blurLabel": false, "buttonName": "Кардиолог", "isComplete": false, "labelPoints": [{"x": 14.98951677316294, "y": 7.8970672414858205}, {"x": 30.550837150642145, "y": 7.8970672414858205}, {"x": 30.550837150642145, "y": 19.417747573328988}, {"x": 14.98951677316294, "y": 19.417747573328988}], "hideOnMobile": false, "mobilePoints": [{"x": 3.8721715173409286, "y": 40.8690642696868}, {"x": 10.334816753742103, "y": 42.86399802427252}, {"x": 10.105614138592756, "y": 71.94657655850327}, {"x": 3.804629581626834, "y": 75.02152054398148}], "hideDoorBlock": false, "mobileLabelPoints": [{"x": 4.640229516334349, "y": 34.018532999098355}, {"x": 26.676074299397477, "y": 34.018532999098355}, {"x": 26.676074299397477, "y": 39.31973548003138}, {"x": 4.640229516334349, "y": 39.31973548003138}], "blinkExpandMobile