fAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Лабораторные исследования назначены неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "Фон лаборатории (анализаторы, пробирки)", "imageURL": "https://dev2.med-game.ru/files/test-1035/Лаборатория (1).png"}, "stepBackgroundImageOpacity": 0}, "internal_id": 28, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:01.924479Z", "updated_at": "2026-06-17T16:18:28.295281Z"}, {"id": 14895, "question_type_id": 2, "is_active": true, "test_id": 1198, "seq_no": 13, "body": {"name": "(4-1) Лабораторные исследования - обоснование", "content": [{"id": 1, "componentData": {"title": "Лабораторные исследования - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Исследование уровня натрийуретического пептида (BNP или NT-proBNP) в крови. - Верно</strong></span></p><p>Определение уровня натрийуретических пептидов является «золотым стандартом» для подтверждения диагноза сердечной недостаточности и оценки ее тяжести.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 2.3, стр. 23. [1].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>2. Анализ крови биохимический (креатинин с рСКФ, калий, натрий) и общий анализ крови. - Верно</strong></span></p><p>Необходимо оценить функцию почек и уровень электролитов (особенно калия) перед назначением диуретиков и других препаратов. Общий анализ крови важен для исключения анемии как фактора, усугубляющего СН.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 2.3, стр. 23-24. [1].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>3. Исследование уровня тропонина I или T в крови. - Верно</strong></span></p><p>Необходимо для исключения острого коронарного синдрома как причины декомпенсации. Небольшое повышение возможно на фоне тахикардии и перегрузки миокарда.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 7.3.2, стр. 97. [1].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>4. Коагулограмма (АЧТВ, МНО) - Верно</strong></span></p><p>Коагулограмма необходима перед началом антикоагулянтной терапии, которая показана при ФП.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>5. D-димер. - Неверно</strong></span></p><p>Рутинное определение D-димера при явной клинике ОДСН нецелесообразно и задержит лечение.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 3.1.6.1 (необходимость антикоагулянтов). [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 39, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10: