p><p>Данных ЭКГ и анамнеза достаточно для уточнения генеза тахикардии. Использование неуточненного диагноза в данной ситуации некорректно [1] (Раздел 1.4, стр. 18).</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Желудочковая тахикардия. - Неверно</strong></span></p><p>Несмотря на широкие комплексы QRS, выраженная нерегулярность ритма и наличие дельта-волн на ЭКГ в сочетании с анамнезом WPW делают диагноз ФП с проведением по ДПП значительно более вероятным [1] (Раздел 3.1.3, стр. 37).</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 41, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:56.965439Z", "updated_at": "2026-06-06T10:21:56.965439Z"}, {"id": 14563, "question_type_id": 2, "is_active": true, "test_id": 1185, "seq_no": 23, "body": {"name": "(8) Лечение", "content": [{"id": 1, "componentData": {"title": "Определите оптимальную тактику неотложной помощи:"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": true, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Лечение назначено верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 2, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Синхронизированная электрическая кардиоверсия.", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Внутривенное введение амиодарона.", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Внутривенное введение верапамила.", "isRightAlt": false, "notRequired": false}, {"id": 4, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Внутривенное введение трифосаденина (АТФ).", "isRightAlt": false, "notRequired": false}, {"id": 5, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Внутривенное введение прокаинамида.", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "checkboxes", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Лечение назначено неверно, скорректируйте", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 56, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 10, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:56.970571Z", "updated_at": "2026-09-23T20:01:48.908978Z"}, {"id": 14564, "question_type_id": 2, "is_active": true, "test_id": 1185, "seq_no": 24, "body": {"name": "(8-1) Лечение - обоснование", "content": [{"id": 1, "componentData": {"title": "Лечение - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Синхронизированная электрическая кардиоверсия. - Верно</strong></span></p><p>Это метод выбора для лечения любой тахикардии, сопровождающейся нестабильной гемодинамикой (АД 90/60 мм рт. ст.). При нерегулярной тахикардии с широкими QRS-комплексами на фоне WPW это наиболее безопасный и эффективный метод [1] (Раздел 3.1.3, стр. 36).</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Внутривенное введение амиодарона. - Неверно</strong></span></p><p>Применение амиодарона не рекомендуется, так как он замедляет проведение в АВ-узле, что может парадоксально увеличить частоту проведения по ДПП и спровоцировать фибрилляцию желудочков. Это потенциально опасное действие [1] (Раздел 3.1.3, стр. 37).</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Внутривенное введение верапамила. - Неверно</strong></span></p><p>Это абсолютное противопоказание. Блокада АВ-узла верапамилом при ФП на фоне синдрома WPW с высокой вероятностью приведёт к трансформации аритмии в фибрилляцию желудочков [1] (Раздел 3.1.2, стр. 36).</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Внутривенное введение трифосаденина (АТФ). - Неверно</strong></span></p><p>Действие аналогично верапамилу. Препарат блокирует АВ-узел и противопоказан при ФП у пациентов с синдромом WPW из-за высокого риска индукции фибрилляции желудочков [1] (Раздел 3.1.3, стр. 37).</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>5. Внутривенное введение прокаинамида. - Неверно</strong></span></p><p>Хотя прокаинамид является препаратом выбора для медикаментозного купирования у гемодинамически стабильных пациентов, при нестабильной гемодинамике методом первого выбора является немедленная ЭИТ [1] (Раздел 3.1.3, стр. 36).</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 42, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:56.976371Z", "updated_at": "2026-06-06T10:21:56.976371Z"}, {"id": 14565, "question_type_id": 2, "is_active": true, "test_id": 1185, "seq_no": 25, "body": {"name": "(9) Диспансеризация", "content": [{"id": 1, "componentData": {"title": "Диспансеризация"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": true, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Тактика выбрана верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 2, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Направление пациента на плановое внутрисердечное ЭФИ с последующей катетерной аблацией дополнительного проводящего пути.", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Назначение постоянной антиаритмической терапии (пропафенон) и наблюдение у кардиолога.", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "