nentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 8, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:50.911312Z", "updated_at": "2026-06-17T16:18:56.942618Z"}, {"id": 14170, "question_type_id": 2, "is_active": true, "test_id": 1170, "seq_no": 10, "body": {"name": "(3-1) Обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Стабильная стенокардия напряжения. - Верно</strong></span></p><p>Источник: Стабильная ИБС, 2024, раздел 2.1, стр. 16. У пациента все три признака типичной стенокардии: характерная боль, связь с нагрузкой и купирование после её прекращения.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Межрёберная невралгия. - Неверно</strong></span></p><p>Источник: Стабильная ИБС, 2024, раздел 2.1, стр. 17. Для невралгии характерна связь боли с положением тела, наклонами, глубоким вдохом, чего нет в данном случае.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. ГЭРБ. - Неверно</strong></span></p><p>Источник: Стабильная ИБС, 2024, раздел 2.1, стр. 17. ГЭРБ связана с приёмом пищи/положением тела, не с физической нагрузкой.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Острый коронарный синдром (ОКС). - Неверно</strong></span></p><p>Источник: Стабильная ИБС, 2024, раздел 1.6, стр. 15. Симптомы стабильны 6 месяцев при определённом уровне нагрузки — характерно для хронического течения ИБС.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name":