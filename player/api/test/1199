: false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Хроническая сердечная недостаточность с сохраненной фракцией выброса.", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Клинический диагноз поставлен неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 32, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:02.400856Z", "updated_at": "2026-06-17T16:18:27.785376Z"}, {"id": 14929, "question_type_id": 2, "is_active": true, "test_id": 1199, "seq_no": 22, "body": {"name": "(7-1) Клинический диагноз - обоснование", "content": [{"id": 1, "componentData": {"title": "Клинический диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Дилатационная кардиомиопатия? ИБС? Осложнения: Хроническая сердечная недостаточность со сниженной фракцией выброса (ХСНнФВ), стадия 2, ФК IV. Пароксизм фибрилляции предсердий, тахисистолическая форма. Полная блокада левой ножки пучка Гиса. Острая декомпенсация сердечной недостаточности. - Верно</strong></span></p><p>Диагноз отражает наличие тяжелой ХСН со сниженной ФВ и ее острое ухудшение на фоне тахиаритмии. Этиология (ИБС или кардиомиопатия) требует уточнения, что отражено в диагнозе. БЛНПГ является важным компонентом диагноза, влияющим на дальнейшую тактику (возможность СРТ).</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 1.4, стр. 18-19; раздел 3.3.1, стр. 70. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Фибрилляция предсердий, постоянная форма. ХСН 1 стадии, ФК II. - Неверно</strong></span></p><p>Эпизод аритмии возник впервые, поэтому форма не может быть расценена как постоянная. Тяжесть клинических проявлений (симптомы в покое) соответствует IV, а не II ФК, а наличие декомпенсации — 2-й стадии ХСН.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 1.4, стр. 16-18. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Хроническая сердечная недостаточность с сохраненной фракцией выброса. - Неверно</strong></span></p><p>По данным ЭхоКГ фракция выброса составляет 32%, что соответствует ХСН со сниженной ФВ (≤40%), а не с сохраненной.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 1.4, стр. 16. [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 41, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:02.406625Z", "updated_at": "2026-06-06T10:22:02.406625Z"}, {"id": 14930, "question_type_id": 2, "is_active": true, "test_id": 1199, "seq_no": 23, "body": {"name": "(8) Лечение", "content": [{"id": 1, "componentData": {"title": "Лечение"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": false, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Тактика лечения выбрана верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 3, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Тактика контроля частоты. Внутривенное введение петлевых диуретиков (фуросемид) для устранения застоя. Назначение бета-блокаторов (с осторожностью) или дигоксина для урежения ЧСС. Начать антикоагулянтную терапию (прямой оральный антикоагулянт).", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Немедленная электрическая кардиоверсия (ЭИТ).", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Имплантация кардиовертера-дефибриллятора (ИКД) для лечения БЛНПГ.", "isRightAlt": false, "notRequired": false}, {"id": 4, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Назначить аспирин, верапамил и увеличить дозу эналаприла.", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Тактика лечения выбрана неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 10, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:02.410095Z", "updated_at": "2026-06-17T16:18:27.907839Z"}, {"id": 14931, "question_type_id": 2, "is_active": true, "test_id": 1199, "seq_no": 24, "body": {"name": "(8-1) Лечение - обоснование", "content": [{"id": 1, "componentData": {"title": "Лечение - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Тактика контроля частоты. Внутривенное введение петлевых диуретиков (фуросемид) для устранения застоя. Назначение бета-блокаторов (с осторожностью) или дигоксина для урежения ЧСС. Начать антикоагулянтную терапию (прямой оральный антикоагулянт). - Верно</strong></span></p><p>У гемодинамически стабильного пациента первоочередной задачей является устранение застоя (диуретики) и урежение ЧСС. Бета-блокаторы являются препаратами выбора, но при выраженной декомпенсации их начинают с малых доз или используют дигоксин. Антикоагулянтная терапия обязательна.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 7.4, стр. 100; раздел 3.1.6.3, стр. 51. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Немедленная электрическая кардиоверсия (ЭИТ). - Неверно</strong></span></p><p>ЭИТ показана при гемодинамической нестабильности. У данного пациента АД стабильно. Проведение ЭИТ без подготовки сопряжено с высоким риском тромбоэмболических осложнений.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 3.1.6.3, стр. 51. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Имплантация кардиовертера-дефибриллятора (ИКД) для лечения БЛНПГ. - Неверно</strong></span></p><p>ИКД не лечит БЛНПГ. Вопрос об имплантации устройства (ИКД или СРТ-Д) для профилактики внезапной смерти и улучшения прогноза решается после стабилизации состояния и оптимизации медикаментозной терапии, а не в острой фазе.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 3.3.2, стр. 72. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Назначить аспирин, верапамил и увеличить дозу эналаприла. - Неверно</strong></span></p><p>Аспирин неэффективен для профилактики инсульта при ФП. Верапамил противопоказан при ХСН со сниженной ФВ из-за отрицательного инотропного эффекта. Лечение требует комплексного подхода, а не только коррекции АД.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 3.1.3.1, стр. 45; раздел 3.1.4, стр. 46. [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 42, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:02.413385Z", "updated_at": "2026-06-06T10:22:02.413385Z"}, {"id": 14932, "question_type_id": 2, "is_active": true, "test_id": 1199, "seq_no": 2