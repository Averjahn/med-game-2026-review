"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Предварительный диагноз поставлен неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 8, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:55.759747Z", "updated_at": "2026-06-17T16:18:42.889074Z"}, {"id": 14478, "question_type_id": 2, "is_active": true, "test_id": 1182, "seq_no": 10, "body": {"name": "(3-1) Обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Острый коронарный синдром с подъемом сегмента ST (ОКСпST) — Верно</strong></span></p><p>У пациентов с сахарным диабетом и пожилых людей ИМ часто протекает с атипичной клиникой (слабость, тошнота, боль в эпигастрии). Сочетание гипотонии и брадикардии характерно для нижнего инфаркта миокарда, который может осложняться АВ-блокадами.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 1.6, стр. 20; раздел 3.4.2.2, стр. 88 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Обострение хронического панкреатита — Неверно</strong></span></p><p>Хотя боль в эпигастрии и тошнота могут быть признаками панкреатита, они не объясняют гемодинамические нарушения (гипотонию, брадикардию) и характерные изменения на ЭКГ, которые указывают на острую кардиальную патологию.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 2.2, стр. 22 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Пищевое отравление — Неверно</strong></span></p><p>Тошнота и рвота могут быть проявлениями как отравления, так и нижнего ИМ. Однако наличие гипотонии и изменений на ЭКГ делает диагноз ИМ гораздо более вероятным и требует неотложных действий.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 2.1, стр. 21 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Синдром слабости синусового узла — Неверно</strong></span></p><p>Хотя брадикардия является одним из симптомов, основной причиной состояния пациента является острая ишемия миокарда, вызвавшая нарушение АВ-проводимости, а не дисфункция синусового узла. Это подтверждается подъемом сегмента ST на ЭКГ.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 3.4.2.2, стр. 88 [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 38, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:55.764495Z", "updated_at": "2026-06-06T10:21:55.764495Z"}, {"id": 14479, "question_type_id": 2, "is_active": true, "test_id": 1182, "seq_no": 12, "body": {"name": "(4) Выберите необходимые лабораторные исследования", "content": [{"id": 1, "componentData": {"title": "Выберите необходимые лабораторные исследования"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": true, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Исследования назначены верно!", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 2, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Тропонин I/T.", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "ОАК.", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "