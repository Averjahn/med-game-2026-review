ороткими пароксизмами, что не соответствует данному случаю.</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Постоянный прием амиодарона. - Неверно</strong></span></p><p>Источник: Наджелудочковые тахикардии, 2025. Приложение А3-2, стр. 113. Длительный прием амиодарона сопряжен с риском побочных эффектов и не является терапией выбора для АВУРТ при наличии более безопасных и эффективных методов, таких как КА.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 56, "checkQuestion": false, "closeSessionPick": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 42, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:57.71563Z", "updated_at": "2026-06-06T10:21:57.71563Z"}, {"id": 14615, "question_type_id": 2, "is_active": true, "test_id": 1187, "seq_no": 2, "body": {"name": "(0.5) Коридор", "content": [{"id": 1, "componentData": {"doors": [{"action": {"name": "moveToStep", "internalId": 2, "checkQuestion": false}, "points": [{"x": 14.562013278753994, "y": 23.094058852466347}, {"x": 18.9849366014377, "y": 26.761157819417736}, {"x": 19.024872703674124, "y": 94.59354456419659}, {"x": 14.522077176517573, "y": 100}], "blurLabel": false, "buttonName": "Кардиолог", "isComplete": false, "labelPoints": [{"x": 14.98951677316294, "y": 7.8970672414858205}, {"x": 30.550837150642145, "y": 7.8970672414858205}, {"x": 30.550837150642145, "y": 19.417747573328988}, {"x": 14.98951677316294, "y": 19.417747573328988}], "hideOnMobile": false, "mobilePoints": [{"x": 3.8721715173409286, "y": 40.8690642696868}, {"x": 10.334816753742103, "y": 42.86399802427