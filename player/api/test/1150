87317Z"}, {"id": 13629, "question_type_id": 2, "is_active": true, "test_id": 1150, "seq_no": 6, "body": {"name": "(2.2) Анамнез заболевания", "content": [{"id": 1, "componentData": {"title": "Анамнез заболевания"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p>Считает себя здоровым. Выраженная брадикардия выявлена впервые при текущем обследовании.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 5, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:42.790148Z", "updated_at": "2026-06-06T10:21:42.790148Z"}, {"id": 13630, "question_type_id": 2, "is_active": true, "test_id": 1150, "seq_no": 7, "body": {"name": "(2.3) Анамнез жизни", "content": [{"id": 1, "componentData": {"title": "Анамнез жизни"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><strong>Спорт:</strong> С 18 лет профессионально занимается триатлоном. Тренировки ежедневные, интенсивные.</p><p><strong>Вредные привычки:</strong> Нет.</p><p><strong>Лекарства:</strong> Не принимает.</p><p><strong>Хронические заболевания:</strong> Отрицает.</p><p><strong>Наследственность:</strong> Дядя по отцовской линии в 48 лет перенес имплантацию ЭКС по поводу «редкого пульса».</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 6, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:42.793163Z", "updated_at": "2026-06-06T10:21:42.793163Z"}, {"id": 13631, "question_type_id": 2, "is_active": true, "test_id": 1150, "seq_no": 8, "body": {"name": "(2.4) Объективное обследование", "content": [{"id": 1, "componentData": {"title": "Объективные данные"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"imagesList": [{"label": "", "imageURL": ""}], "clickEnlarge": true, "imagesWidthPercent": 80, "imagesWidthPercentSmall": 100, "imagesWidthPercentMobile": 100}, "componentName": "ContentImages"}, {"id": 3, "componentData": {"text": "<ul><li><p><strong>Общее состояние:</strong> Удовлетворительное. Телосложение атлетическое.</p></li><li><p><strong>Кожные покровы:</strong> Чистые, нормальной окраски.</p></li><li><p><strong>Дыхание:</strong> Везикулярное, хрипов нет. ЧДД 14/мин.</p></li><li><p><strong>Сердце:</strong> Тоны ясные, ритм правильный. ЧСС — 42 уд/мин. АД — 110/70 мм рт. ст.</p></li></ul>"}, "componentName": "ContentText"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 12, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:42.798384Z", "updated_at": "2026-06-06T10:21:42.798384Z"}, {"id": 13632, "question_type_id": 2, "is_active": true, "test_id": 1150, "seq_no": 9, "body": {"name": "(3) Предварительный диагноз", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": true, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Предварительный диагноз поставлен верно", "color": "#A3D65C", "image": {"