000;\"><strong>4. Тромболизис - Неверно</strong></span></p><p>Не показан и вреден при ОКСбпST.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 51, "checkQuestion": false, "closeSessionPick": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 42, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:51.850533Z", "updated_at": "2026-06-06T10:21:51.850533Z"}, {"id": 14234, "question_type_id": 2, "is_active": true, "test_id": 1172, "seq_no": 2, "body": {"name": "(0.5) Коридор", "content": [{"id": 1, "componentData": {"doors": [{"action": {"name": "moveToStep", "internalId": 2, "checkQuestion": false}, "points": [{"x": 14.562013278753994, "y": 23.094058852466347}, {"x": 18.9849366014377, "y": 26.761157819417736}, {"x": 19.024872703674124, "y": 94.59354456419659}, {"x": 14.522077176517573, "y": 100}], "blurLabel": false, "buttonName": "Кардиолог", "isComplete": false, "labelPoints": [{"x": 14.98951677316294, "y": 7.8970672414858205}, {"x": 30.550837150642145, "y": 7.8970672414858205}, {"x": 30.550837150642145, "y": 19.417747573328988}, {"x": 14.98951677316294, "y": 19.417747573328988}], "hideOnMobile": false, "mobilePoints": [{"x": 3.8721715173409286, "y": 40.8690642696868}, {"x": 10.334816753742103, "y": 42.86399802427252}, {"x": 10.105614138592756, "y": 71.94657655850327}, {"x": 3.804629581626834, "y": 75.02152054398148}], "hideDoorBlock": false, "mobileLabelPoints": [{"x": 4.640229516334349, "y": 34.018532999098355}, {"x": 26.676074299397477, "y": 34.018532999098355}, {"x": 26.676074299397477, "y": 39.31973548003138}, {"x": 4.640229516334349, "y": 