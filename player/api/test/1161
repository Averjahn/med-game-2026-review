ction": {"name": "previous", "internalId": 29, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 32, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:47.263551Z", "updated_at": "2026-06-06T10:21:47.263551Z"}, {"id": 13937, "question_type_id": 2, "is_active": true, "test_id": 1161, "seq_no": 19, "body": {"name": "(7-1) Клинический диагноз - обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Клинический диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Синдром Бругада, спонтанный 1-й тип ЭКГ. Синкопальная форма. Пароксизмы полиморфной ЖТ. Высокий риск ВСС. - Верно</strong></span></p><p>Диагноз выставлен на основании наличия диагностического ЭКГ-паттерна и жизнеугрожающих симптомов (синкопе), что автоматически относит пациента к группе высокого риска. Источник: Желудочковые аритмии-2020, раздел 1.5, стр. 13; раздел 3.3, стр. 62. </p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Идиопатическая желудочковая тахикардия. - Неверно</strong></span></p><p>Диагноз неправомерен, так как установлена конкретная причина аритмии — синдром Бругада. Источник: Желудочковые аритмии-2020, раздел 1.1, стр. 9. </p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Синдром ранней реполяризации желудочков. - Неверно</strong></span></p><p>Хотя этот синдром также связан с элевацией ST, морфология и локализация подъема (обычно в нижних и боковых отведениях) отличаются от типичной картины синдрома Бругада. Источник: Желудочковые аритмии-2020, раздел 1.5, стр. 13.</p>"}, "componentName": "ContentText"}, 