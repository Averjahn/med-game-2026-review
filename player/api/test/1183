swersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Диагноз поставлен неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 29, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 32, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:56.215625Z", "updated_at": "2026-06-06T10:21:56.215625Z"}, {"id": 14512, "question_type_id": 2, "is_active": true, "test_id": 1183, "seq_no": 22, "body": {"name": "(7-1) Клинический диагноз - обоснование", "content": [{"id": 1, "componentData": {"title": "Клинический диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Основное заболевание: Острый инфаркт миокарда с подъемом сегмента ST (ИМпST) передне-перегородочной локализации, тип 1, Killip I. Осложнение: Окклюзия проксимального отдела передней межжелудочковой ветви левой коронарной артерии (по данным КГ). Сопутствующие заболевания: Сахарный диабет 2 типа. Гиперлипидемия. Артериальная гипертензия 2 степени, 3 стадия, риск 4 (очень высокий). Курение — Верно</strong></span></p><p>Данный диагноз отражает всю полученную информацию: подтвержденный ИМпST по ЭКГ и тропонинам, локализацию, данные КГ, тип ИМ (атеротромботический), отсутствие признаков ОСН (Killip I), а также все сопутствующие заболевания и факторы риска, влияющие на прогноз.</p><p>Источник: КР «Острый инфаркт миокарда с подъемом сегмента ST», 2024, раздел 1.1, стр. 12; раздел 1.5, стр. 18–19; раздел 1.6, стр. 20; раздел 2.3, стр. 23; раздел 2.4, стр. 26; Приложение А3, стр. 182, 198 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Острый инфаркт миокарда без подъема сегмента ST — Неверно</strong></span></p><p>На ЭКГ четко зафиксирован подъем сегмента ST, что исключает диагноз ИМбпST.</p><p>Источник: КР «Острый инфаркт миокарда с подъемом сегмента ST», 2024, раздел 1.1, стр. 12; раздел 1.5, стр. 18 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Нестабильная стенокардия — Неверно</strong></span></p><p>Диагностические критерии (повышение тропонина, стойкий подъем ST) подтверждают некроз миокарда, что соответствует инфаркту, а не стенокардии.</p><p>Источник: КР «Острый инфаркт миокарда с подъемом сегмента ST», 2024, раздел 1.1, стр. 12; раздел 1.6, стр. 20 [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 41, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:56.220246Z", "updated_at": "2026-06-06T10:21: