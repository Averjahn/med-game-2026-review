onName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 8, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:59.254172Z", "updated_at": "2026-06-17T16:18:34.674606Z"}, {"id": 14710, "question_type_id": 2, "is_active": true, "test_id": 1191, "seq_no": 10, "body": {"name": "(3-1) Обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Постоянная форма фибрилляции предсердий (ФП). - Верно</strong></span></p><p>Диагноз основан на длительности симптомов более 1 года и решении не восстанавливать синусовый ритм. Источник: раздел 1.5, стр. 16 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Пароксизмальная форма ФП. - Неверно</strong></span></p><p>Пароксизмальная форма купируется самостоятельно, как правило, в течение 48 часов, но не позднее 7 суток. Источник: раздел 1.5, стр. 16 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Персистирующая форма ФП. - Неверно</strong></span></p><p>Персистирующая форма длится более 7 дней, но при этом сохраняется стратегия контроля ритма. У данного пациента аритмия длится более года. Источник: раздел 1.5, стр. 16 [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 38, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:59.258225Z", "updated_at": "2026-06-06T10:21:59.258225Z"}, {"id": 14711, "question_type_id": 2, "is_active": true, "test_id": 1191, "seq_no": 12, "body": {"name": "(4) Выберите необходимые лабораторные исследования", "content": [{"id": 1, "componentData": {"title": "Выберите необходимые лабораторные исследования"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": true, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Исследования назначены верно!", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 2, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Общий анализ крови (с определением уровня гемоглобина и тромбоцитов).", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Биохимический анализ крови (креатинин с расчетом КК, АСТ,