eURL": ""}, "action": {"name": "next", "internalId": 56, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 10, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:59.298927Z", "updated_at": "2026-09-23T20:02:17.060684Z"}, {"id": 14721, "question_type_id": 2, "is_active": true, "test_id": 1191, "seq_no": 24, "body": {"name": "(8-1) Лечение - обоснование", "content": [{"id": 1, "componentData": {"title": "Лечение - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Стратегия «контроль частоты». - Верно</strong></span></p><p>Для пациентов с постоянной формой ФП и симптомами, связанными с тахикардией, рекомендован контроль ЧСС. Источники: раздел 3.1.2.1, Таблица П6, стр. 41-42, 157 [1].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>2. Назначение пероральных антикоагулянтов. - Верно</strong></span></p><p>У пациента высокий риск по CHA2DS2-VASc (возраст, АГ, СД, ИМ в анамнезе, ХСН). Необходим прием ПОАК с коррекцией дозы по функции почек. Источники: раздел 3.1.1.1, Таблица П10, стр. 23, 161 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Назначение амиодарона для восстановления синусового ритма. - Неверно</strong></span></p><p>При постоянной форме ФП стратегия контроля ритма не является первоочередной и сопряжена с рисками побочных эффектов, особенно у пожилых. Источник: раздел 3.1.2.3.1, стр. 50-51 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Назначение ацетилсалициловой кислоты. - Неверно</strong></span></p><p>Антиагреганты не рекомендованы для профилактики инсульта при ФП. Источник: раздел 3.1.1.1, стр. 26 [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 42, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:59.303658Z", "updated_at": "2026-06-06T10:21:59.303658Z"}, {"id": 14722, "question_type_id": 2, "is_active": true, "test_id": 1191, "seq_no": 25, "body": {"name": "(9) Диспансеризация", "content": [{"id": 1, "componentData": {"title": "Диспансеризация"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": true, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "План диспансеризации составлен верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 3, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Регулярный контроль ЧСС, АД. Контроль ЭКГ 1 раз в 6-12 мес. Контроль функции почек не реже 1 раза в год.", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Оценка приверженности к антикоагулянтной терапии при каждом визите.", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "check