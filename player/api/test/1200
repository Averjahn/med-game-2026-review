nentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 45, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:02.772318Z", "updated_at": "2026-06-17T16:18:26.292698Z"}, {"id": 14951, "question_type_id": 2, "is_active": true, "test_id": 1200, "seq_no": 16, "body": {"name": "(5-1) Инструментальные исследования - обоснование", "content": [{"id": 1, "componentData": {"title": "Инструментальные исследования - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. ЭКГ в 12 отведениях. - Верно</strong></span></p><p>Основной метод для диагностики аритмии и нарушений проводимости.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 2.4.1, стр. 25. [1].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>2. Эхокардиография (ЭхоКГ) у постели больного. - Верно</strong></span></p><p>Необходимо срочно оценить фракцию выброса ЛЖ, степень аортальной недостаточности и исключить другие острые причины декомпенсации. Не должна задерживать неотложные лечебные мероприятия.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 2.4.2, стр. 25. [1].</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>3. Рентгенография органов грудной клетки. - Верно</strong></span></p><p>Позволяет подтвердить наличие отека легких и кардиомегалии.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 2.4.3, стр. 29. [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Чреспищеводная эхокардиография (ЧПЭхоКГ). - Неверно</strong></span></p><p>В острой ситуации у нестабильного пациента ЧПЭхоКГ не является методом первой линии. Показания к ней могут возникнуть позже.</p><p>Источник: КР Хроническая сердечная недостаточность, 2024, раздел 2.4.6, стр. 30. [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 46, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:02.777403Z", "updated_at": "2026-06-06T10:22:02.777403Z"}, {"id": 14952, "question_type_id": 2, "is_active": true, "test_id": 1200, "seq_no": 18, "body": {"name": "(6) Результаты", "content": [{"id": 1, "componentData": {"title": "Результаты лабораторных и инструментальных исследований"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"warnings": false, "sectionsList": [{"image": {"label": "", "imageURL": "https://a0f484dc-cc45-4930-b9c1-08b90f1e91e8.selstorage.ru/testfiles/test-512/laboratory.svg"}, "action": {"name": "moveToStep", "internalId": 30, "checkQuestion": false}, "buttonName": "Лабораторные исследования"}, {"image": {"label": "", "imageURL": "https://a0f484dc-cc45-4930-b9c1-08b90f1e91e8.selstorage.ru/testfiles/test-512/instrumental.svg"}, "action": {"name": "moveToStep", "internalId": 31, "checkQuestion": false}, "buttonName": "Инструментальные исследования"}], "warningParameters": {"text": "Дополнительное обследование проведено не полностью", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "markCompletedSections": true}, "componentName": "ContentSections"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": "