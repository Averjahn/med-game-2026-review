seModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 29, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 32, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:54.949717Z", "updated_at": "2026-06-06T10:21:54.949717Z"}, {"id": 14436, "question_type_id": 2, "is_active": true, "test_id": 1180, "seq_no": 22, "body": {"name": "(7-1) Клинический диагноз - обоснование", "content": [{"id": 1, "componentData": {"title": "Клинический диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. I21.0 Острый трансмуральный инфаркт миокарда передне-боковой стенки левого желудочка. Острая левожелудочковая недостаточность, Killip II — Верно</strong></span></p><p>Диагноз точно отражает локализацию инфаркта по данным ЭКГ и ЭхоКГ (передне-распространенный). Наличие влажных хрипов в легких классифицируется как Killip II. Код I21.0 соответствует ИМ передней стенки.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 1.4, стр. 17; раздел 3.4.1, стр. 79 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. I21.1 Острый трансмуральный инфаркт миокарда нижней стенки — Неверно</strong></span></p><p>Код I21.1 и диагноз инфаркта нижней стенки не соответствуют данным ЭКГ, на которых элевация ST регистрируется в передних и боковых отведениях (V1–V4, I, aVL).</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 1.4, стр. 17 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. I24.0 Коронарный тромбоз, не приводящий к инфаркту миокарда — Неверно</strong></span></p><p>Этот диагноз ставится, когда на фоне лечения некроз миокарда не успел развиться (нет значимого повышения тропонинов). У данного пациента имеется выраженное повышение уровня тропонина, что подтверждает состоявшийся ИМ.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 1.4, стр. 17 [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 41, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:54.953857Z", "updated_at": "2026-06-06T10:21:54.953857Z"}, {"id": 14437, "question_type_id": 2, "is_active": true, "test_id": 1180, "seq_no": 23, "body": {"name": "(8) Лечение", "content": [{"id": 1, "componentData": {"title": "Определите оптимальную тактику лечения:"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 1, "markers": [], "hintText": "", "multiple": false, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Лечение назначено верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 2, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Немедленная КГ + ЧКВ инфаркт-связанной артерии. Лучевой доступ, стент с лекарственным покрытием. ДАТТ (АСК 150–300 мг + тикагрелор 180 мг) + НФГ 70–100 МЕ/кг.", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "ТЛТ в приёмном.", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Консервативная терапия, отложить ЧКВ на 24–48 ч.", "isRightAlt": false, "notRequired": false}, {"id": 4, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Экстренное АКШ.", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Лечение назначено неверно, скорректируйте", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 51, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 10, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:54.957895Z", "updated_at": "2026-09-23T20:01:41.417828Z"}, {"id": 14438, "question_type_id": 2, "is_active": true, "test_id": 1180, "seq_no": 24, "body": {"name": "(8-1) Лечение - обоснование", "content": [{"id": 1, "componentData": {"title": "Лечение - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Немедленная коронарография с намерением выполнить первичное ЧКВ инфаркт-связанной артерии (лучевой доступ, стент с лекарственным покрытием) + ДАТТ (АСК 150–300 мг разжевать + тикагрелор 180 мг) + НФГ в/в болюсно 70–100 МЕ/кг — Верно</strong></span></p><p>Первичное ЧКВ — это метод выбора для реперфузии, если оно может быть выполнено в течение 120 минут от постановки диагноза. Лучевой доступ и использование стентов с лекарственным покрытием являются стандартами. Комбинация АСК + тикагрелор и НФГ является рекомендованной для сопровождения первичного ЧКВ у пациентов без противопоказаний.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 3.1.1, стр. 31; раздел 3.1.2, стр. 33; раздел 3.2.3.2, стр. 53–58 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Проведение тромболитической терапии (ТЛТ) в приемном отделении — Неверно</strong></span></p><p>ТЛТ показана только в случае, если невозможно выполнить первичное ЧКВ в рекомендованные сроки (&lt;120 мин). В условиях ЧКВ-центра проведение ТЛТ является ошибкой и задержкой адекватного лечения.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 3.1.1, стр. 31 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Начать консервативную терапию (обезболивание, антикоагулянты), отложить ЧКВ на 24–48 часов — Неверно</strong></span></p><p>Отказ от экстренной реперфузии при ИМпST в первые 12 часов от начала симптомов значительно увеличивает размер некроза, риск осложнений и смертность. Это грубейшая тактическая ошибка.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 3.1.1, стр. 31 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Экстренное аортокоронарное шунтирование (КШ) — Неверно</strong></span></p><p>Экстренное КШ при ИМпST не является методом выбора и выполняется по строгим показаниям, таким как невозможность выполнения ЧКВ, определенная анатомия коронарных артерий или наличие механических осложнений инфаркта. Первичным методом реваскуляризации является ЧКВ.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 3.1.6, стр. 42 [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false, "closeSessionPick": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 42, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:54.96218Z", "updated_at": "2026-09-23T20:01:41.948469Z"}, {"id": 14439, "question_type_id": 2, "is_active": true, "test_id": 1180, "seq_no": 11, "body": {"name": "(3.5) Коридор к лаборатории", "content": [{"id": 1, "componentData": {"doors": [{"action": {"name": "moveToStep", "internalId": 0, "checkQuestion": false}, "points": [{"x": 14.562013278753994, "y": 23.094058852466347}, {"x": 18.9849366014377, "y": 26.761157819417736}, {"x": 19.024872703674124, "y": 94.59354456419659}, {"x": 14.522077176517573, "y": 100}], "blurLabel": true, "buttonName": "Кардиолог", "isComplete": false, "labelPoints": [{"x": 14.98951677316294, "y": 7.8970672414858205}, {"x": 30.550837150642145, "y": 7.8970672414858205}, {"x": 30.550837150642145, "y": 19.417747573328988}, {"x": 14.98951677316294, "y": 19.417747573328988}], "hideOnMobile": false, "mobilePoints": [{"x": 3.8721715173409286, "y": 40.8690642696868}, {"x": 10.334816753742103, "y": 42.86399802427252}, {"x": 10.105614138592756, "y": 71.94657655850327}, {"x": 3.804629581626834, "y": 75.0215205