], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "buttons", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Предварительный диагноз поставлен неверно", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 8, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:54.51284Z", "updated_at": "2026-06-17T16:18:49.93346Z"}, {"id": 14403, "question_type_id": 2, "is_active": true, "test_id": 1179, "seq_no": 10, "body": {"name": "(3-1) Обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Острый коронарный синдром с подъемом сегмента ST (ОКСпST) — Верно</strong></span></p><p>У пожилых пациентов, женщин и больных сахарным диабетом ОКС часто протекает с атипичной клинической картиной (одышка, слабость, боль в эпигастрии), что соответствует данному случаю. Наличие признаков кардиогенного шока также указывает на тяжелое поражение сердца.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 1.6, стр. 20; раздел 2.1, стр. 21 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Декомпенсация хронической сердечной недостаточности (ХСН) — Неверно</strong></span></p><p>Хотя симптомы соответствуют острой декомпенсации ХСН, ее причиной в данном случае, вероятнее всего, является ОКС, который и должен быть основным диагнозом, определяющим неотложную тактику.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 3.4, стр. 78 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Тромбоэмболия легочной артерии (ТЭЛА) — Неверно</strong></span></p><p>ТЭЛА является важным дифференциальным диагнозом. Однако сочетание признаков лево- и правожелудочковой недостаточности (хрипы в легких и набухание шейных вен) на фоне гипотонии более характерно для обширного инфаркта миокарда, осложненного кардиогенным шоком.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 2.4, стр. 29 [1].</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Острый холецистит — Неверно</strong></span></p><p>Дискомфорт в эпигастрии может быть одним из проявлений ИМ, но наличие тяжелой одышки, гипоксии и гемодинамической нестабильности делает диагноз патологии ЖКТ маловероятным в качестве основного.</p><p>Источник: КР «Инфаркт миокарда с подъемом сегмента ST ЭКГ», 2024, раздел 2.2, стр. 22 [1].</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}]}, "internal_id": 38, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:54.518125Z", "updated_at": "2026-06-06T10:21:54.518125Z"}, {"id": 14404, "question_type_id": 2, "is_active": true, "test_id": 1179, "seq_no": 12, "body": {"name": "(4) Выберите необходимые лабораторные исследования", "content": [{"id": 1, "componentData": {"title": "Выберите необходимые лабораторные исследования"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": true, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Исследования назначены верно!", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 2, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Тропонин I/T.", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Биохимия (креатинин с рСКФ, глюкоза, калий).", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Общий анализ крови.", "isRightAlt": false, "notRequired": false}, {"id": 4, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Газы артериальной крови и КОС.", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1, 2, 3, 4], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "checkboxes", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "sho