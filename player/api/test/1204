енировки, как правило, приводят к улучшению липидного профиля [1]. Источник: КР «Нарушения липидного обмена», 2023, раздел 2.2, стр. 13.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 38, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:04.609441Z", "updated_at": "2026-06-06T10:22:04.609441Z"}, {"id": 15057, "question_type_id": 2, "is_active": true, "test_id": 1204, "seq_no": 11, "body": {"name": "(3.5) Коридор к лаборатории Copy Copy", "content": [{"id": 1, "componentData": {"doors": [{"action": {"name": "moveToStep", "internalId": 0, "checkQuestion": false}, "points": [{"x": 15.416666666666668, "y": 22.12962962962963}, {"x": 19.6875, "y": 25.64814814814815}, {"x": 20.104166666666668, "y": 99.9074074074074}, {"x": 15.885416666666666, "y": 100}], "blurLabel": true, "buttonName": "Кардиолог", "isComplete": false, "labelPoints": [{"x": 15.46875, "y": 7.8970672414858125}, {"x": 31.030070377479205, "y": 7.8970672414858125}, {"x": 31.030070377479205, "y": 19.417747573328995}, {"x": 15.46875, "y": 19.417747573328995}], "hideOnMobile": false, "mobilePoints": [{"x": 3.049495131626397, "y": 35.48484519675926}, {"x": 7.912717016124877, "y": 36.73484519675926}, {"x": 8.39375869352429, "y": 74.59020543981481}, {"x": 3.9426742568646644, "y": 77.37955729166667}], "hideDoorBlock": false, "mobileLabelPoints": [{"x": 3.6182769847845644, "y": 28.37474149004185}, {"x": 25.65412176784769, "y": 28.37474149004185}, {"x": 25.65412176784769, "y": 33.67594397097487}, {"x": 3.6182769847845644, "y": 3