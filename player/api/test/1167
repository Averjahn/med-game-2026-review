mageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Рутинные онкомаркеры", "isRightAlt": false, "notRequired": false}], "hintWarning": {"text": "Будет дана подсказка", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useModalHint": false, "partlyCorrect": {"text": "Не все верные отмечены", "color": "#FFA000", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "isAnswersOnImage": false, "answerCollections": [{"id": 1, "name": "Верный ответ", "seqNo": 1, "isRight": true, "checkedList": [], "description": "", "selectedIdList": [1, 2, 3, 4, 5], "collectionWarning": {"text": "Все верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "useCollectionWarning": false}], "answersButtonType": "checkboxes", "isAnswersWithImage": false, "combinationOfAnswers": [], "modalHintDescription": "", "allCorrectPartlyIncorrect": {"text": "Отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "allInorrectPartlyIncorrect": {"text": "Лабораторные исследования назначены неверно, скорректируйте!", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "partlyCorrectpartlyIncorrect": {"text": "Не все верные отмечены, отмечены лишние пункты", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}}, "componentName": "ContentAnswers"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 3, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "Фон лаборатории (анализаторы, пробирки)", "imageURL": "https://dev2.med-game.ru/files/test-1035/Лаборатория (1).png"}, "stepBackgroundImageOpacity": 0}, "internal_id": 28, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:49.639255Z", "updated_at": "2026-06-17T16:18:59.859718Z"}, {"id": 14091, "question_type_id": 2, "is_active": true, "test_id": 1167, "seq_no": 13, "body": {"name": "(4-1) Лабораторные исследования - обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Лабораторные исследования - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Общий (клинический) анализ крови развернутый (Hb, эритроциты, лейкоциты) - Верно</strong></span></p><p>Комментарий: всем при ИБС/подозрении, исключение сопутствующей патологии, вторичных причин стенокардии. Источник: раздел 2.3, «Общий анализ крови…».[1]</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>2. Липидный профиль: ОХС, ХсЛНП, ХсЛВП, ТГ; расчет не-ЛВП - Верно</strong></span></p><p>Комментарий: ключевой фактор риска; при гипертриглицеридемии/СД — расчет не-ЛВП целесообразен. Источник: раздел 2.3 (липиды, не-ЛВП, целевые уровни).[3][1]</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>3. Глюкоза натощак, HbA1c; при неубедительных — ПГТТ - Верно</strong></span></p><p>Комментарий: скрининг СД при наличии оснований. Источник: раздел 2.3 (скрининг СД).[1]</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>4. Креатинин, расчет СКФ/КК - Верно</strong></span></p><p>Комментарий: для коррекции доз лекарств и оценки функции почек. Источник: раздел 2.3.[1]</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>5. АСТ/АЛТ при приеме статинов - Верно</strong></span></p><p>Комментарий: у пациентов на статинах каждые 6 мес. Источник: раздел 2.3.[3][1]</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>6. Рутинное определение тропонина при стабильной симптоматике без признаков ОКС - Неверно</strong></span></p><p>Комментарий: тропонин показан при клинической нестабильности/подозрении на ОКС. Источник: раздел 2.3 (тропонин — при подозрении на ОКС).[1]</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>7. Рутинные онкомаркеры - Неверно</strong></span></p><p>Комментарий: не входят в стандарт обследования стабильной ИБС. Источник: раздел 2.3 (перечень релевантных тестов).[1]</p><p></p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "Фон лаборатории (анализаторы, пробирки)", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 39, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:49.644509Z", "updated_at": "2026-06-06T10:21:49.644509Z"}, {"id": 14092, "question_type_id": 2, "is_active": true, "test_id": 1167, "seq_no": 15, "body": {"name": "(5) Выберите необходимые инструментальные исследования", "content": [{"id": 1, "componentData": {"title": "Выберите необходимые инструментальные исследования"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText