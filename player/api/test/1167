kQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "Фон инструментальной диагностики", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 37, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:49.650601Z", "updated_at": "2026-06-17T16:19:00.288197Z"}, {"id": 14093, "question_type_id": 2, "is_active": true, "test_id": 1167, "seq_no": 16, "body": {"name": "(5-1) Инструментальные исследования - обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Инструментальные исследования - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. ЭКГ в покое 12 отведений; по возможности — во время/сразу после боли - Верно</strong></span></p><p>Комментарий: всем при подозрении на ИБС; во время боли информативнее. Источник: раздел 2.4.1 (ЭКГ).[1]</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>2. ЭхоКГ покоя с допплером - Верно</strong></span></p><p>Комментарий: ФВ, НЛС, диастолическая функция, клапаны, исключение иной патологии. Источник: раздел 2.4.1 (ЭхоКГ).[1]</p><p></p><p><span style=\"font-size: 18px; color: #028800;\"><strong>3. Выбор первого специфического теста: визуализирующий стресс‑метод (стресс-ЭхоКГ/ОФЭКТ/ПЭТ/стресс‑МРТ) ИЛИ МСКТ‑коронарография - Верно</strong></span></p><p>Комментарий: при ПТВ>15% — предпочтительны стресс‑визуализационные тесты; МСКТ КА — допустима альтернатива, особенно при низко‑умеренной ПТВ и хороших условиях визуализации. Источник: раздел 2.4.1 (выбор метода; EOK I B; IIa C).[1]</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>4. Холтер только «для выявления ишемии» - Неверно</strong></span></p><p>Комментарий: не рекомендован для диагностики ишемии; применяется при аритмиях/вазоспазме. Источник: раздел 2.4.1 (Холтер — не для выявления ишемии; III B).[1]</p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>5. Изолированная оценка коронарного кальция как тест на стенозы - Неверно</strong></span></p><p>Комментарий: не рекомендуют использовать изолированно для диагностики стенозов >50%. Источник: раздел 2.4.1 (III C).[1]</p><p></p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "Фон инструментальной диагностики", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 40, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:21:49.656195Z", "updated_at": "2026-06-06T10:21:49.656195Z"}, {"id": 14094, "question_type_id": 2, "is_active": true, "test_id": 1167, "seq_no": 18, "body": {"name": "(6) Результаты", "content": [{"id": 1, "componentData": {"title": "Результаты лабораторных и инструментальных исследований"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"warnings": false, "sectionsList": [{"image": {"label": "", "imageURL": "https://a0f484dc-cc45-4930-b9c1-08b90f1e91e8.selstorage.ru/testfiles/test-512/laboratory.svg"}, "action": {"name": "moveToStep", "internalId": 30, "checkQuestion": false}, "buttonName": "Лабораторные исследования"}, {"image": {"label": "", "imageURL": "https://a0f484dc-cc45-4930-b9c1-08b90f1e91e8.selstorage.ru/testfiles/test-512/instrumental.svg"}, "action": {"name": "moveToStep", "internalId": 31, "checkQuestion": false}, "buttonName": "Инструментальные исследования"}], "warningParameters": {"text": "Дополнительное обследо