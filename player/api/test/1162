026-06-06T10:21:47.580982Z", "updated_at": "2026-06-17T16:19:04.699358Z"}, {"id": 13954, "question_type_id": 2, "is_active": true, "test_id": 1162, "seq_no": 10, "body": {"name": "(3-1) Обоснование результатов", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз - обоснование"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p><span style=\"font-size: 18px; color: #028800;\"><strong>1. Аритмогенная кардиомиопатия правого желудочка (АКПЖ). - Верно</strong></span></p><p>Источник: Желудочковые аритмии-2020, раздел 3.3, стр. 57. В пользу диагноза: молодой возраст, спортсмен, синкопе на фоне нагрузки, семейный анамнез ВСС, желудочковые аритмии. Это классическая клиническая картина АКПЖ. </p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>2. Гипертрофическая кардиомиопатия (ГКМП). - Неверно</strong></span></p><p>Источник: Желудочковые аритмии-2020, раздел 3.3, стр. 75. Хотя ГКМП также является частой причиной ВСС у спортсменов, для нее характерно утолщение стенки левого, а не правого желудочка, и другие ЭКГ-признаки. </p><p></p><p><span style=\"font-size: 18px; color: #880000;\"><strong>3. Идиопатическая желудочковая тахикардия из выходного тракта правого желудочка. - Неверно</strong></span></p><p>Источник: Желудочковые аритмии-2020, раздел 3.2, стр. 50. Эта аритмия обычно имеет доброкачественный прогноз и редко приводит к синкопе. При АКПЖ аритмия является следствием структурного заболевания миокарда, что определяет высокий риск ВСС</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 0, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}