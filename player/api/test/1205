15Z", "updated_at": "2026-06-06T10:22:04.937015Z"}, {"id": 15076, "question_type_id": 2, "is_active": true, "test_id": 1205, "seq_no": 3, "body": {"name": "(1) Общая информация", "content": [{"id": 1, "componentData": {"title": "Общая информация", "titleIcon": {"label": "", "imageURL": ""}}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"imagesList": [{"label": "", "imageURL": "https://dev2.med-game.ru/files/test-1648/Vegeter_1.jpg"}], "clickEnlarge": true, "imagesWidthPercent": 60, "imagesWidthPercentSmall": 80, "imagesWidthPercentMobile": 100}, "componentName": "ContentImages"}, {"id": 3, "componentData": {"text": "<p><span style=\"font-size: 18px\"><strong>Пациент</strong></span></p><p>Мужчина 38 лет, вегетарианец последние 6 лет, обратился к терапевту на профилактический осмотр. Активных жалоб не предъявляет.</p>"}, "componentName": "ContentText"}, {"id": 4, "componentData": {"text": "<p>Цели: проведите обследование, поставьте диагноз, назначьте обследования и лечебную тактику, рекомендуйте диспансерное наблюдение согласно клиническим рекомендациям 2023 «Нарушения липидного обмена».</p><p>Источник: «Нарушения липидного обмена». Клинические рекомендации 2023. ВНОК [1].</p>"}, "componentName": "ContentText"}, {"id": 5, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 2, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:04.944705Z", "updated_at": "2026-06-06T10:22:04.944705Z"}, {"id": 15077, "question_type_id": 2, "is_active": true, "test_id": 1205, "seq_no": 4, "body": {"name": "(2) Первичный осмотр", "content": [{"id": 1, "componentData": {"title": "Осмотр"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"warnings": true, "sectionsList": [{"image": {"label": "", "imageURL": "https://ec888558-9aef-47ea-b714-138f4c46d9f3.selstorage.ru/testfiles/test-117/inspection1.svg"}, "action": {"name": "moveToStep", "internalId": 4, "checkQuestion": false}, "buttonName": "Жалобы"}, {"image": {"label": "", "imageURL": "https://ec888558-9aef-47ea-b714-138f4c46d9f3.selstorage.ru/testfiles/test-117/inspection2.svg"}, "action": {"name": "moveToStep", "internalId": 5, "checkQuestion": false}, "buttonName": "Анамнез заболевания"}, {"image": {"label": "", "imageURL": "https://ec888558-9aef-47ea-b714-138f4c46d9f3.selstorage.ru/testfiles/test-117/inspection3.svg"}, "action": {"name": "moveToStep", "internalId": 6, "checkQuestion": false}, "buttonName": "Анамнез жизни"}, {"image": {"label": "", "imageURL": "https://ec888558-9aef-47ea-b714-138f4c46d9f3.selstorage.ru/testfiles/test-191/inspection4.svg"}, "action": {"name": "moveToStep", "internalId": 12, "checkQuestion": false}, "buttonName": "Объективное обследование"}], "warningParameters": {"text": "Осмотр выполнен не полностью", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "markCompletedSections": true}, "componentName": "ContentSections"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 2, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 8, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 3, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:04.949738Z", "updated_at": "2026-06-06T10:22:04.949738Z"}, {"id": 15078, "question_type_id": 2, "is_active": true, "test_id": 1205, "seq_no": 5, "body": {"name": "(2.1) Жалобы", "content": [{"id": 1, "componentData": {"title": "Жалобы"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p>В момент обращения жалоб нет. Гипертриглицеридемия выявлена по результатам диспансеризации. Иногда отмечает быструю утомляемость после обильной углеводистой пищи.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 4, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:04.953213Z", "updated_at": "2026-06-06T10:22:04.953213Z"}, {"id": 15079, "question_type_id": 2, "is_active": true, "test_id": 1205, "seq_no": 6, "body": {"name": "(2.2) Анамнез заболевания", "content": [{"id": 1, "componentData": {"title": "Анамнез заболевания"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p>Повышение триглицеридов (ТГ) впервые выявлено год назад, периодически контролировал показатели. Ранее ТГ 2,0–3,0 ммоль/л, в настоящее время 3,8 ммоль/л (повторные анализы через несколько месяцев — без выраженной динамики). Диеты не придерживался; красное мясо осознанно не употребляет, употребляет молочные продукты, много фруктов, сладостей, крупяных гарниров, выпечки и сухофруктов.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 5, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:04.958347Z", "updated_at": "2026-06-06T10:22:04.958347Z"}, {"id": 15080, "question_type_id": 2, "is_active": true, "test_id": 1205, "seq_no": 7, "body": {"name": "(2.3) Анамнез жизни", "content": [{"id": 1, "componentData": {"title": "Анамнез жизни"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p>Не курит, алкоголь употребляет редко (не чаще раза в месяц, умеренно). Артериальное давление в пределах нормы. Детские инфекции, операции и хронические заболевания отрицает. В семье по линии отца: инфаркт миокарда у деда в 59 лет. Аллергологический анамнез не отягощён. Работа сидячая, физической активностью занимается эпизодически (в среднем менее одного раза в неделю).</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 6, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:04.961782Z", "updated_at": "2026-06-06T10:22:04.961782Z"}, {"id": 15081, "question_type_id": 2, "is_active": true, "test_id": 1205, "seq_no": 8, "body": {"name": "(2.4) Объективное обследование", "content": [{"id": 1, "componentData": {"title": "Объективные данные"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"imagesList": [{"label": "", "imageURL": ""}], "clickEnlarge": true, "imagesWidthPercent": 80, "imagesWidthPercentSmall": 100, "imagesWidthPercentMobile": 100}, "componentName": "ContentImages"}, {"id": 3, "componentData": {"text": "<p>Общее состояние удовлетворительное. Вес 79 кг, рост 176 см, ИМТ 25,5 кг/м². Окружность талии 92 см. Кожные покровы без особенностей, ксантомы и ксантелазмы не выявлены, липоидная дуга роговицы отсутствует. Тоны сердца ясные, шумов нет, ритм правильный. АД 126/78 мм рт. ст. Пульс 74 уд/мин.</p>"}, "componentName": "ContentText"}, {"id": 4, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 12, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:04.965683Z", "updated_at": "2026-06-06T10:22:04.965683Z"}, {"id": 15082, "question_type_id": 2, "is_active": true, "test_id": 1205, "seq_no": 9, "body": {"name": "(3) Предварительный диагноз", "content": [{"id": 1, "componentData": {"title": "Предварительный диагноз"}, "componentName": "ContentTitle"}, {"id": 3, "componentData": {"hints": true, "columns": 2, "markers": [], "hintText": "", "multiple": false, "textData": {"text": ""}, "warnings": true, "doShuffle": true, "allCorrect": {"text": "Предварительный диагноз поставлен верно", "color": "#A3D65C", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "imagesData": {"imagesList": [{"label": "", "imageURL": ""}], "imagesWidthPercent": 100}, "totalHints": 2, "answersList": [{"id": 1, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Гипертриглицеридемия.", "isRightAlt": false, "notRequired": false}, {"id": 2, "image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "doAction": false, "internalId": 0, "clickAction": false, "checkQuestion": false, "trackRepeatAnswer": false}, "isRight": false, "answerText": "Вторичная гиперлипидемия (в том числе связанная с сахарным диабетом, гипотиреозом).", "isRightAlt": false, "notRequired": false}, {"id": 3, "image": {"label": "", "imageURL": ""}, "a