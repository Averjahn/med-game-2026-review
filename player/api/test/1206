81Z", "updated_at": "2026-06-06T10:22:05.314981Z"}, {"id": 15103, "question_type_id": 2, "is_active": true, "test_id": 1206, "seq_no": 3, "body": {"name": "(1) Общая информация", "content": [{"id": 1, "componentData": {"title": "Общая информация", "titleIcon": {"label": "", "imageURL": ""}}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"imagesList": [{"label": "", "imageURL": "https://dev2.med-game.ru/files/test-1646/Patient_1.jpg"}], "clickEnlarge": true, "imagesWidthPercent": 60, "imagesWidthPercentSmall": 80, "imagesWidthPercentMobile": 100}, "componentName": "ContentImages"}, {"id": 3, "componentData": {"text": "<p><span style=\"font-size: 18px\"><strong>Пациент</strong></span></p><p>Мужчина 48 лет обратился на амбулаторный приём к кардиологу по поводу профилактического осмотра.</p>"}, "componentName": "ContentText"}, {"id": 4, "componentData": {"text": "<p>Цели: проведите обследование, определите тип дислипидемии, оцените сердечно-сосудистый риск и назначьте лечение в соответствии с КР РКО 2023.</p><p>Источник: «Нарушения липидного обмена». Клинические рекомендации 2023. Общероссийская общественная организация «Российское кардиологическое общество», Минздрав РФ [1].</p>"}, "componentName": "ContentText"}, {"id": 5, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "next", "internalId": 0, "checkQuestion": false}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 2, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:05.319382Z", "updated_at": "2026-06-06T10:22:05.319382Z"}, {"id": 15104, "question_type_id": 2, "is_active": true, "test_id": 1206, "seq_no": 4, "body": {"name": "(2) Первичный осмотр", "content": [{"id": 1, "componentData": {"title": "Осмотр"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"warnings": true, "sectionsList": [{"image": {"label": "", "imageURL": "https://ec888558-9aef-47ea-b714-138f4c46d9f3.selstorage.ru/testfiles/test-117/inspection1.svg"}, "action": {"name": "moveToStep", "internalId": 4, "checkQuestion": false}, "buttonName": "Жалобы"}, {"image": {"label": "", "imageURL": "https://ec888558-9aef-47ea-b714-138f4c46d9f3.selstorage.ru/testfiles/test-117/inspection2.svg"}, "action": {"name": "moveToStep", "internalId": 5, "checkQuestion": false}, "buttonName": "Анамнез заболевания"}, {"image": {"label": "", "imageURL": "https://ec888558-9aef-47ea-b714-138f4c46d9f3.selstorage.ru/testfiles/test-117/inspection3.svg"}, "action": {"name": "moveToStep", "internalId": 6, "checkQuestion": false}, "buttonName": "Анамнез жизни"}, {"image": {"label": "", "imageURL": "https://ec888558-9aef-47ea-b714-138f4c46d9f3.selstorage.ru/testfiles/test-191/inspection4.svg"}, "action": {"name": "moveToStep", "internalId": 12, "checkQuestion": false}, "buttonName": "Объективное обследование"}], "warningParameters": {"text": "Осмотр выполнен не полностью", "color": "#FF6D6D", "image": {"label": "", "imageURL": ""}, "buttons": [{"action": {"name": "closeModalWarning"}, "buttonName": "Закрыть"}], "showTime": 0}, "markCompletedSections": true}, "componentName": "ContentSections"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "previous", "internalId": 2, "checkQuestion": false}, "buttonName": "Назад"}, {"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 8, "checkQuestion": true}, "buttonName": "Далее"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 3, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:05.322883Z", "updated_at": "2026-06-06T10:22:05.322883Z"}, {"id": 15105, "question_type_id": 2, "is_active": true, "test_id": 1206, "seq_no": 5, "body": {"name": "(2.1) Жалобы", "content": [{"id": 1, "componentData": {"title": "Жалобы"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p>Активных жалоб не предъявляет. Отмечает редкие эпизоды утомляемости при физической нагрузке.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 4, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:05.328256Z", "updated_at": "2026-06-06T10:22:05.328256Z"}, {"id": 15106, "question_type_id": 2, "is_active": true, "test_id": 1206, "seq_no": 6, "body": {"name": "(2.2) Анамнез заболевания", "content": [{"id": 1, "componentData": {"title": "Анамнез заболевания"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p>Повышение уровня холестерина впервые выявлено год назад. Лекарственную терапию не назначали. Сахарный диабет и артериальную гипертензию отрицает.</p>"}, "componentName": "ContentText"}, {"id": 3, "componentData": {"buttonsList": [{"image": {"label": "", "imageURL": ""}, "action": {"name": "moveToStep", "internalId": 3, "checkQuestion": false}, "buttonName": "Закрыть"}]}, "componentName": "ContentButtons"}], "stepBackgroundImage": {"label": "", "imageURL": ""}, "stepBackgroundImageOpacity": 0}, "internal_id": 5, "question_text": "", "created_by": "admin", "updated_by": "admin", "created_at": "2026-06-06T10:22:05.333307Z", "updated_at": "2026-06-06T10:22:05.333307Z"}, {"id": 15107, "question_type_id": 2, "is_active": true, "test_id": 1206, "seq_no": 7, "body": {"name": "(2.3) Анамнез жизни", "content": [{"id": 1, "componentData": {"title": "Анамнез жизни"}, "componentName": "ContentTitle"}, {"id": 2, "componentData": {"text": "<p>Ожир